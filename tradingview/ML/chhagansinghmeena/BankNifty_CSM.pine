    var b = array.new_float(0)
    var css = array.new_color(0)
    if isFirstbar
        for i = 0 to length - 1 by 1
            x = i / (length - 1)
            w = math.avg(math.atan(2 * math.pi * (1 - math.pow(x, beta))) , math.sin(2 * math.pi * (1 - math.pow(x, beta))))
