    src_sum = 0.0
    for i = 0 to length - 1 by 1
        src_sum += src[i] * array.get(b, i)
        src_sum
    src_sum := src_sum / array.sum(b)
    
    os_css = math.avg(ta.mfi(src_sum, length)/100, ta.rsi(src_sum, length)/100) 
