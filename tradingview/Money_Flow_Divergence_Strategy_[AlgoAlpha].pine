// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Based on "Money Flow Divergence Zones [AlgoAlpha]" — converted to Strategy

//@version=6
strategy("Money Flow Divergence Strategy [AlgoAlpha]", "AlgoAlpha - MFD Strategy",
     overlay = true,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     commission_type = strategy.commission.percent,
     commission_value = 0.1,
     slippage = 1)

// ── Inputs ────────────────────────────────────────────────────────────────────
len            = input.int(14,    "MFI Length",          tooltip = "Lookback length for the Money Flow Index")
lookbackLeft   = input.int(14,    "Pivot Lookback Left",  minval = 1, group = "Divergence")
lookbackRight  = input.int(5,     "Pivot Lookback Right", minval = 1, group = "Divergence")
expiry_age     = input.int(1000,  "Max Zone Age",         minval = 1, group = "Management")
mitigate       = input.string("body", "Sweep Type", options = ["wick", "body"], group = "Management")
allow_rejection = input.bool(false, "Allow Rejection", group = "Management")

entryGroup = "Entry"
useDiv     = input.bool(true,  "Enter on Divergence",      group = entryGroup, tooltip = "Long on bullish divergence, Short on bearish divergence")
useTouch   = input.bool(false, "Enter on Zone Touch",       group = entryGroup, tooltip = "Long when price touches bullish zone with a bullish candle, and vice-versa")
useOscX    = input.bool(false, "Enter on Oscillator Cross", group = entryGroup, tooltip = "Long on osc cross-up, Short on osc cross-down")

exitGroup  = "Exit"
useOpposite = input.bool(true,  "Exit on Opposite Signal",  group = exitGroup)
useMitigation = input.bool(false, "Exit on Zone Mitigation", group = exitGroup)

green = input.color(#00ffbb, "Bullish Colour", group = "Appearance")
red   = input.color(#ff1100, "Bearish Colour", group = "Appearance")

// ── Functions ─────────────────────────────────────────────────────────────────
_inRange(bool cond) =>
    bars = ta.barssince(cond)
    5 <= bars and bars <= 60

// ── Core calculations (identical to indicator) ────────────────────────────────
v        = ta.mfi(close, len)
v_smooth = ta.hma(v, 21)

zoneExtremeLen  = 5
bullExtreme     = ta.lowest(low,                       zoneExtremeLen)[lookbackRight]
bullBodyExtreme = ta.lowest(math.min(open, close),     zoneExtremeLen)[lookbackRight]
bearExtreme     = ta.highest(high,                     zoneExtremeLen)[lookbackRight]
bearBodyExtreme = ta.highest(math.max(open, close),    zoneExtremeLen)[lookbackRight]

plFound  = false
phFound  = false
bullCond = false
bearCond = false

oscLBR  = v[lookbackRight]
lowLBR  = low[lookbackRight]
highLBR = high[lookbackRight]

var bullZoneEdge = array.new_line()
var bullZoneBase = array.new_line()
var bearZoneEdge = array.new_line()
var bearZoneBase = array.new_line()

bull_mitigated = false
bear_mitigated = false
bull_in_fill   = false
bear_in_fill   = false

// Divergence detection
plFound   := not na(ta.pivotlow(v, lookbackLeft, lookbackRight))
oscHL      = oscLBR > ta.valuewhen(plFound, oscLBR, 1) and _inRange(plFound[1])
priceLL    = lowLBR < ta.valuewhen(plFound, lowLBR, 1)
bullCond  := priceLL and oscHL and plFound

phFound   := not na(ta.pivothigh(v, lookbackLeft, lookbackRight))
oscLH      = oscLBR < ta.valuewhen(phFound, oscLBR, 1) and _inRange(phFound[1])
priceHH    = highLBR > ta.valuewhen(phFound, highLBR, 1)
bearCond  := priceHH and oscLH and phFound

// Zone management — bullish
if bullCond
    xStart   = bar_index - lookbackRight
    bullEdge = line.new(xStart, bullExtreme,     bar_index + 1, bullExtreme,     color = green,                  width = 1, force_overlay = true)
    bullBase = line.new(xStart, bullBodyExtreme, bar_index + 1, bullBodyExtreme, color = color.new(green, 80),   width = 1, force_overlay = true)
    array.unshift(bullZoneEdge, bullEdge)
    array.unshift(bullZoneBase, bullBase)
    linefill.new(bullZoneEdge.first(), bullZoneBase.first(), color.new(green, 82))

if bearCond
    xStart   = bar_index - lookbackRight
    bearEdge = line.new(xStart, bearExtreme,     bar_index + 1, bearExtreme,     color = red,                    width = 1, force_overlay = true)
    bearBase = line.new(xStart, bearBodyExtreme, bar_index + 1, bearBodyExtreme, color = color.new(red, 80),     width = 1, force_overlay = true)
    array.unshift(bearZoneEdge, bearEdge)
    array.unshift(bearZoneBase, bearBase)
    linefill.new(bearZoneEdge.first(), bearZoneBase.first(), color.new(red, 82))

// Extend / mitigate bull zones
if array.size(bullZoneEdge) > 0
    for ln = array.size(bullZoneEdge) - 1 to 0
        if ln < array.size(bullZoneEdge)
            cL  = array.get(bullZoneEdge, ln)
            cL_ = array.get(bullZoneBase, ln)
            yL  = cL.get_y1()
            x1  = cL.get_x1()
            age = bar_index - x1

            sweep_price      = mitigate == "body" ? close : low
            sweep_price_prev = mitigate == "body" ? close[1] : low[1]

            remove_by_mitigation = false
            if allow_rejection and mitigate == "body"
                remove_by_mitigation := sweep_price < yL and sweep_price_prev < yL
            else
                remove_by_mitigation := sweep_price < yL

            if remove_by_mitigation or age > expiry_age
                array.remove(bullZoneEdge, ln)
                array.remove(bullZoneBase, ln)
                bull_mitigated := true
            else
                zoneTop      = math.max(cL.get_y1(), cL_.get_y1())
                zoneBot      = math.min(cL.get_y1(), cL_.get_y1())
                bull_in_fill := bull_in_fill or (high >= zoneBot and low <= zoneTop)
                cL.set_x2(bar_index + 1)
                cL_.set_x2(bar_index + 1)

// Extend / mitigate bear zones
if array.size(bearZoneEdge) > 0
    for ln = array.size(bearZoneEdge) - 1 to 0
        if ln < array.size(bearZoneEdge)
            cL  = array.get(bearZoneEdge, ln)
            cL_ = array.get(bearZoneBase, ln)
            yL  = cL.get_y1()
            x1  = cL.get_x1()
            age = bar_index - x1

            sweep_price      = mitigate == "body" ? close : high
            sweep_price_prev = mitigate == "body" ? close[1] : high[1]

            remove_by_mitigation = false
            if allow_rejection and mitigate == "body"
                remove_by_mitigation := sweep_price > yL and sweep_price_prev > yL
            else
                remove_by_mitigation := sweep_price > yL

            if remove_by_mitigation or age > expiry_age
                array.remove(bearZoneEdge, ln)
                array.remove(bearZoneBase, ln)
                bear_mitigated := true
            else
                zoneTop      = math.max(cL.get_y1(), cL_.get_y1())
                zoneBot      = math.min(cL.get_y1(), cL_.get_y1())
                bear_in_fill := bear_in_fill or (high >= zoneBot and low <= zoneTop)
                cL.set_x2(bar_index + 1)
                cL_.set_x2(bar_index + 1)

// ── Derived signals ───────────────────────────────────────────────────────────
bull_touch_char = bull_in_fill and close > open
bear_touch_char = bear_in_fill and close < open
osc_cross_up    = ta.crossover(v_smooth,  v_smooth[1])
osc_cross_down  = ta.crossunder(v_smooth, v_smooth[1])

// ── Entry signals (offset-adjusted: divergence fires lookbackRight bars late) ─
longSignal  = (useDiv   and bullCond)       or
              (useTouch  and bull_touch_char) or
              (useOscX   and osc_cross_up)

shortSignal = (useDiv   and bearCond)       or
              (useTouch  and bear_touch_char) or
              (useOscX   and osc_cross_down)

// ── Exit signals ──────────────────────────────────────────────────────────────
closeLong  = (useOpposite   and shortSignal) or
             (useMitigation and bull_mitigated)

closeShort = (useOpposite   and longSignal)  or
             (useMitigation and bear_mitigated)

// ── Strategy orders ───────────────────────────────────────────────────────────
if longSignal
    strategy.entry("Long", strategy.long)
if shortSignal
    strategy.entry("Short", strategy.short)
if closeLong
    strategy.close("Long")
if closeShort
    strategy.close("Short")

// ── Visuals (oscillator pane) ─────────────────────────────────────────────────
noneColor = color.new(color.white, 100)
osc_col   = v_smooth > v_smooth[1] ? green : red

midline_transparency = int(90 - math.min(90, math.abs(v_smooth - 50) * 2))
osc_plot    = plot(v_smooth,      "Oscillator",        osc_col, 1,   display = display.pane)
signal_plot = plot(v_smooth[1],   "Signal Line",       color.new(osc_col, 100), display = display.pane)
plot(v,                           "MFI",               color.new(chart.fg_color, 70), display = display.pane)
plot(51, color = color.new(v_smooth > 50 ? green : red, midline_transparency),
     linewidth = 4, trackprice = false, histbase = 49, style = plot.style_columns, display = display.pane)
fill(osc_plot, signal_plot, color = color.new(osc_col, 88), title = "Fast Fill")

plotchar(osc_cross_up   or osc_cross_down ? v_smooth[1] : na,
     title = "Osc Cross", char = "●", location = location.absolute, color = osc_col, size = size.tiny, display = display.pane)

// Divergence shapes on chart
plot(plFound ? oscLBR : na, offset = -lookbackRight, title = "Bull Div Line",
     linewidth = 2, color = bullCond ? green : noneColor, display = display.pane)
plotshape(bullCond ? oscLBR : na, offset = -lookbackRight, title = "Bull Div Label",
     text = "▲", style = shape.labelup, location = location.absolute, color = green, textcolor = color.white, display = display.pane)
plot(phFound ? oscLBR : na, offset = -lookbackRight, title = "Bear Div Line",
     linewidth = 2, color = bearCond ? red : noneColor, display = display.pane)
plotshape(bearCond ? oscLBR : na, offset = -lookbackRight, title = "Bear Div Label",
     text = "▼", style = shape.labeldown, location = location.absolute, color = red, textcolor = color.white, display = display.pane)

// Price-chart markers
plot(plFound ? lowLBR : na, offset = -lookbackRight,
     linewidth = 2, color = bullCond ? green : noneColor, force_overlay = true)
plot(phFound ? highLBR : na, offset = -lookbackRight,
     linewidth = 2, color = bearCond ? red : noneColor, force_overlay = true)
plotshape(bullCond, offset = -lookbackRight, title = "Bull Price Label",
     text = "▲", style = shape.labelup,   location = location.belowbar, color = green, textcolor = color.white, force_overlay = true)
plotshape(bearCond, offset = -lookbackRight, title = "Bear Price Label",
     text = "▼", style = shape.labeldown, location = location.abovebar, color = red,   textcolor = color.white, force_overlay = true)
plotchar(bull_touch_char, title = "Bull Zone Touch", char = "▲", location = location.belowbar, color = green, size = size.tiny, force_overlay = true)
plotchar(bear_touch_char, title = "Bear Zone Touch", char = "▼", location = location.abovebar, color = red,   size = size.tiny, force_overlay = true)

// ── Alerts ────────────────────────────────────────────────────────────────────
alertcondition(bullCond,        title = "Regular Bullish Divergence",  message = "Bullish divergence — potential long setup.")
alertcondition(bearCond,        title = "Regular Bearish Divergence",  message = "Bearish divergence — potential short setup.")
alertcondition(bull_mitigated,  title = "Bullish Zone Mitigated",      message = "Bullish liquidity zone mitigated or expired.")
alertcondition(bear_mitigated,  title = "Bearish Zone Mitigated",      message = "Bearish liquidity zone mitigated or expired.")
alertcondition(bull_touch_char, title = "Bullish Zone Touch",          message = "Price touching bullish zone with bullish candle.")
alertcondition(bear_touch_char, title = "Bearish Zone Touch",          message = "Price touching bearish zone with bearish candle.")
alertcondition(osc_cross_up,    title = "Oscillator Cross Up",         message = "Oscillator crossed above its signal line.")
alertcondition(osc_cross_down,  title = "Oscillator Cross Down",       message = "Oscillator crossed below its signal line.")
