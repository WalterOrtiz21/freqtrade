//@version=6
indicator("CHoCH/BOS Complete TP",
         shorttitle="CHoCH/BOS",
         overlay=true,
         max_boxes_count=500,
         max_lines_count=500)

// ═════════════════════════════════════════════════════════
// PARAMETERS
// ═════════════════════════════════════════════════════════

// Structure Detection
zigzag_len = input.int(23, "ZigZag Length", minval=5, maxval=50, group="Structure")

// Entry Filters
require_fvg = input.bool(true, "Require FVG Retest", group="Entry Filters")
fvg_lookback = input.int(20, "FVG Lookback Period", minval=10, maxval=50, group="Entry Filters")

// Risk Management
stop_loss_pct = input.float(13.0, "Stop Loss %", minval=5, maxval=25, group="Risk Management")

// Take Profit System (Dual: ROI + BOS Counting) - MATCHING PYTHON
use_roi_system = input.bool(true, "Enable ROI System", group="Take Profit", tooltip="Time-based profit targets (matching Python)")
roi_0 = input.float(10.0, "ROI 0min (%)", minval=3, maxval=30, step=0.5, group="Take Profit")
roi_60 = input.float(5.0, "ROI 60min (%)", minval=1, maxval=15, step=0.5, group="Take Profit")
roi_120 = input.float(3.0, "ROI 120min (%)", minval=0.5, maxval=10, step=0.5, group="Take Profit")
roi_240 = input.float(1.0, "ROI 240min (%)", minval=0.5, maxval=5, step=0.5, group="Take Profit")

// Visual Settings
show_entries = input.bool(true, "Show Entry Signals", group="Visual")
show_exits = input.bool(true, "Show Exit Signals", group="Visual")
show_tp_signals = input.bool(true, "Show TP1/TP2 Signals", group="Visual")
show_sl = input.bool(true, "Show Stop Loss Levels", group="Visual")
show_structure = input.bool(false, "Show Structure (CHoCH/BOS)", group="Visual")
show_fvg = input.bool(true, "Show FVG Zones", group="Visual")
show_pivots = input.bool(false, "Show Pivots", group="Visual")
show_price_labels = input.bool(false, "Show Price Labels", group="Visual")
show_connection_lines = input.bool(true, "Show Connection Lines", group="Visual")

// ═════════════════════════════════════════════════════════
// PIVOT DETECTION
// ═════════════════════════════════════════════════════════

pivot_high = ta.pivothigh(high, zigzag_len, zigzag_len)
pivot_low = ta.pivotlow(low, zigzag_len, zigzag_len)

var float last_pivot_high = na
var float last_pivot_low = na
var int last_pivot_high_bar = na
var int last_pivot_low_bar = na

if not na(pivot_high)
    last_pivot_high := pivot_high
    last_pivot_high_bar := bar_index[zigzag_len]
    
if not na(pivot_low)
    last_pivot_low := pivot_low
    last_pivot_low_bar := bar_index[zigzag_len]

// ═════════════════════════════════════════════════════════
// MARKET STRUCTURE (CHoCH & BOS)
// ═════════════════════════════════════════════════════════

var int trend = 0  // 0=neutral, 1=bearish, 2=bullish
var bool choch_bull = false
var bool choch_bear = false
var bool bos_bull = false
var bool bos_bear = false

// Reset signals each bar
choch_bull := false
choch_bear := false
bos_bull := false
bos_bear := false

if not na(last_pivot_high) and not na(last_pivot_low)

    // NEUTRAL - establishing initial trend
    if trend == 0
        if close > last_pivot_high
            bos_bull := true
            trend := 2
        else if close < last_pivot_low
            bos_bear := true
            trend := 1

    // BEARISH TREND
    else if trend == 1
        if close < last_pivot_low
            bos_bear := true  // Continuation
        else if close > last_pivot_high
            choch_bull := true  // Change of character
            trend := 2

    // BULLISH TREND
    else if trend == 2
        if close > last_pivot_high
            bos_bull := true  // Continuation
        else if close < last_pivot_low
            choch_bear := true  // Change of character
            trend := 1

// Track when CHoCH happened (for recent filter)
var int choch_bull_bar = 0
var int choch_bear_bar = 0

if choch_bull
    choch_bull_bar := bar_index
if choch_bear
    choch_bear_bar := bar_index

choch_bull_recent = (bar_index - choch_bull_bar) <= 20
choch_bear_recent = (bar_index - choch_bear_bar) <= 20

// ═════════════════════════════════════════════════════════
// FVG (FAIR VALUE GAP) DETECTION
// ═════════════════════════════════════════════════════════

// Bullish FVG: low[0] > high[2]
fvg_bull = low > high[2]
fvg_bull_top = fvg_bull ? low : na
fvg_bull_bottom = fvg_bull ? high[2] : na

// Bearish FVG: high[0] < low[2]
fvg_bear = high < low[2]
fvg_bear_top = fvg_bear ? low[2] : na
fvg_bear_bottom = fvg_bear ? high : na

// Check if FVG has been retested in next fvg_lookback bars
var float[] fvg_bull_tops = array.new_float(0)
var float[] fvg_bull_bottoms = array.new_float(0)
var int[] fvg_bull_bars = array.new_int(0)

var float[] fvg_bear_tops = array.new_float(0)
var float[] fvg_bear_bottoms = array.new_float(0)
var int[] fvg_bear_bars = array.new_int(0)

// Store bullish FVG
if fvg_bull
    array.push(fvg_bull_tops, low)
    array.push(fvg_bull_bottoms, high[2])
    array.push(fvg_bull_bars, bar_index)

// Store bearish FVG
if fvg_bear
    array.push(fvg_bear_tops, low[2])
    array.push(fvg_bear_bottoms, high)
    array.push(fvg_bear_bars, bar_index)

// Check for FVG retest
fvg_bull_filled = false
fvg_bear_filled = false

// Check bullish FVG retest
if array.size(fvg_bull_tops) > 0
    for i = array.size(fvg_bull_tops) - 1 to 0
        if bar_index - array.get(fvg_bull_bars, i) <= fvg_lookback
            top = array.get(fvg_bull_tops, i)
            bottom = array.get(fvg_bull_bottoms, i)
            if low <= top and high >= bottom
                fvg_bull_filled := true
                break

// Check bearish FVG retest
if array.size(fvg_bear_tops) > 0
    for i = array.size(fvg_bear_tops) - 1 to 0
        if bar_index - array.get(fvg_bear_bars, i) <= fvg_lookback
            top = array.get(fvg_bear_tops, i)
            bottom = array.get(fvg_bear_bottoms, i)
            if high >= bottom and low <= top
                fvg_bear_filled := true
                break

// ═════════════════════════════════════════════════════════
// ENTRY CONDITIONS
// ═════════════════════════════════════════════════════════

// LONG: Recent CHoCH bullish + BOS bullish + (optional FVG)
long_base = bos_bull and choch_bull_recent
long_condition = require_fvg ? (long_base and fvg_bull_filled) : long_base

// SHORT: Recent CHoCH bearish + BOS bearish + (optional FVG)
short_base = bos_bear and choch_bear_recent
short_condition = require_fvg ? (short_base and fvg_bear_filled) : short_base

// ═════════════════════════════════════════════════════════
// POSITION TRACKING & DUAL TP SYSTEM
// ═════════════════════════════════════════════════════════

var bool in_long_position = false
var bool in_short_position = false
var float long_entry_price = na
var float short_entry_price = na
var float long_sl = na
var float short_sl = na
var int long_entry_bar = na
var int short_entry_bar = na

// BOS Counting System is disabled.

// ROI System tracking
var float current_roi_target = 10.0  // Dynamic ROI target based on time

// Entry execution with TP system reset
if long_condition and not in_long_position and not in_short_position
    in_long_position := true
    long_entry_price := close
    long_entry_bar := bar_index
    long_sl := long_entry_price * (1 - stop_loss_pct/100)
    in_short_position := false

if short_condition and not in_short_position and not in_long_position
    in_short_position := true
    short_entry_price := close
    short_entry_bar := bar_index
    short_sl := short_entry_price * (1 + stop_loss_pct/100)
    in_long_position := false

// BOS Counting Logic is disabled.

// ROI System: Calculate dynamic target based on time in position
if in_long_position or in_short_position
    bars_in_position = bar_index - (in_long_position ? long_entry_bar : short_entry_bar)
    minutes_in_position = bars_in_position * 15  // Assuming 15m timeframe
    
    if minutes_in_position >= 240
        current_roi_target := roi_240  // 1% after 4 hours
    else if minutes_in_position >= 120
        current_roi_target := roi_120  // 3% after 2 hours
    else if minutes_in_position >= 60
        current_roi_target := roi_60   // 5% after 1 hour
    else
        current_roi_target := roi_0    // 10% anytime

// Exit conditions (multiple systems)
var bool long_exit_roi = false
var bool short_exit_roi = false
var bool long_exit_choch = false
var bool short_exit_choch = false

// Reset exit flags each bar
long_exit_roi := false
short_exit_roi := false
long_exit_choch := false
short_exit_choch := false

// ROI-based exits
if use_roi_system and in_long_position
    profit_pct = ((close - long_entry_price) / long_entry_price) * 100
    if profit_pct >= current_roi_target
        long_exit_roi := true

if use_roi_system and in_short_position
    profit_pct = ((short_entry_price - close) / short_entry_price) * 100
    if profit_pct >= current_roi_target
        short_exit_roi := true

// BOS Counting-based exits are disabled.

// CHoCH-based exits (always active)
long_exit_choch := choch_bear and in_long_position
short_exit_choch := choch_bull and in_short_position

// Combined exit logic
long_exit = long_exit_roi or long_exit_choch
short_exit = short_exit_roi or short_exit_choch

// Reset position tracking on complete exit
if long_exit
    in_long_position := false
    long_entry_price := na
    long_sl := na
    long_entry_bar := na

if short_exit
    in_short_position := false
    short_entry_price := na
    short_sl := na
    short_entry_bar := na

// Stop Loss hit detection (overrides all other exits)
if in_long_position and low <= long_sl
    in_long_position := false
    long_entry_price := na
    long_sl := na
    long_entry_bar := na

if in_short_position and high >= short_sl
    in_short_position := false
    short_entry_price := na
    short_sl := na
    short_entry_bar := na

// ═════════════════════════════════════════════════════════
// VISUAL ELEMENTS
// ═════════════════════════════════════════════════════════

// Pivots
plotshape(show_pivots and not na(pivot_high), "Pivot H", shape.triangledown,
         location.abovebar, color.new(color.red, 30), size=size.tiny)

plotshape(show_pivots and not na(pivot_low), "Pivot L", shape.triangleup,
         location.belowbar, color.new(color.lime, 30), size=size.tiny)

// Structure levels
plot(show_structure ? last_pivot_high : na, "Last High",
     color.new(color.red, 50), 1, plot.style_stepline)

plot(show_structure ? last_pivot_low : na, "Last Low",
     color.new(color.lime, 50), 1, plot.style_stepline)

// CHoCH & BOS markers
plotshape(show_structure and choch_bull, "CHoCH↑", shape.labelup,
         location.belowbar, color.lime, text="CHoCH",
         textcolor=color.white, size=size.normal)

plotshape(show_structure and choch_bear, "CHoCH↓", shape.labeldown,
         location.abovebar, color.red, text="CHoCH",
         textcolor=color.white, size=size.normal)

plotshape(show_structure and bos_bull, "BOS↑", shape.circle,
         location.belowbar, color.new(color.lime, 50), size=size.tiny)

plotshape(show_structure and bos_bear, "BOS↓", shape.circle,
         location.abovebar, color.new(color.red, 50), size=size.tiny)

// FVG Boxes
var box fvg_bull_box = na
var box fvg_bear_box = na

if show_fvg and fvg_bull
    fvg_bull_box := box.new(bar_index, low, bar_index + fvg_lookback, high[2],
                             border_color=color.new(color.lime, 70),
                             bgcolor=color.new(color.lime, 90),
                             border_width=1)

if show_fvg and fvg_bear
    fvg_bear_box := box.new(bar_index, high, bar_index + fvg_lookback, low[2],
                             border_color=color.new(color.red, 70),
                             bgcolor=color.new(color.red, 90),
                             border_width=1)

// ═════════════════════════════════════════════════════════
// ENTRY SIGNALS (FLECHAS)
// ═════════════════════════════════════════════════════════

// Entry signals con mejor visibilidad
plotshape(show_entries and long_condition and not in_long_position[1] and not in_short_position[1], "Long Entry", shape.labelup,
         location.belowbar, color.new(color.green, 40), size=size.normal,
         text="▲", textcolor=color.white)

plotshape(show_entries and short_condition and not in_short_position[1] and not in_long_position[1], "Short Entry", shape.labeldown,
         location.abovebar, color.new(color.red, 40), size=size.normal,
         text="▼", textcolor=color.white)

// ═════════════════════════════════════════════════════════
// TP1/TP2 SIGNALS (DIAMANTES)
// ═════════════════════════════════════════════════════════

// NOTE: TP/ROI signals are disabled to match the requested visual style.
// A single orange 'x' is used for all exits.

// ═════════════════════════════════════════════════════════
// LÍNEAS Y ETIQUETAS
// ═════════════════════════════════════════════════════════

// Líneas punteadas desde la señal hasta el precio
var line long_entry_line = na
var line short_entry_line = na
var line long_exit_line = na
var line short_exit_line = na

if show_connection_lines
    // Línea de entrada LONG
    if long_condition and not in_long_position[1] and not in_short_position[1]
        long_entry_line := line.new(bar_index, close, bar_index, close * 0.98, color=color.lime, width=2, style=line.style_dashed)
    
    // Línea de entrada SHORT
    if short_condition and not in_short_position[1] and not in_long_position[1]
        short_entry_line := line.new(bar_index, close, bar_index, close * 1.02, color=color.red, width=2, style=line.style_dashed)
    
    // Línea de salida LONG
    if in_long_position[1] and not in_long_position
        long_exit_line := line.new(bar_index, close[1], bar_index, close[1] * 1.02, color=color.red, width=2, style=line.style_dashed)
        line.delete(long_entry_line)
    
    // Línea de salida SHORT
    if in_short_position[1] and not in_short_position
        short_exit_line := line.new(bar_index, close[1], bar_index, close[1] * 0.98, color=color.red, width=2, style=line.style_dashed)
        line.delete(short_entry_line)

// Etiquetas de precio separadas del gráfico
if show_price_labels
    // Etiqueta de entrada LONG
    if long_condition and not in_long_position[1] and not in_short_position[1]
        label.new(bar_index, close * 0.98, "LONG @" + str.tostring(close, format.mintick),
                 color=color.lime, textcolor=color.white, size=size.small,
                 style=label.style_label_down, yloc=yloc.price)
    
    // Etiqueta de entrada SHORT
    if short_condition and not in_short_position[1] and not in_long_position[1]
        label.new(bar_index, close * 1.02, "SHORT @" + str.tostring(close, format.mintick),
                 color=color.red, textcolor=color.white, size=size.small,
                 style=label.style_label_up, yloc=yloc.price)
    
    // Etiqueta de salida LONG
    if in_long_position[1] and not in_long_position
        exit_reason = long_exit_roi ? "ROI" : "CHoCH"
        label.new(bar_index, close[1] * 1.03, "EXIT (" + exit_reason + ") @" + str.tostring(close[1], format.mintick),
                 color=color.red, textcolor=color.white, size=size.small,
                 style=label.style_label_up, yloc=yloc.price)
    
    // Etiqueta de salida SHORT
    if in_short_position[1] and not in_short_position
        exit_reason = short_exit_roi ? "ROI" : "CHoCH"
        label.new(bar_index, close[1] * 0.97, "EXIT (" + exit_reason + ") @" + str.tostring(close[1], format.mintick),
                 color=color.red, textcolor=color.white, size=size.small,
                 style=label.style_label_down, yloc=yloc.price)

// ═════════════════════════════════════════════════════════
// EXIT SIGNALS (X)
// ═════════════════════════════════════════════════════════

// Unified Exit signals
plotshape(show_exits and in_long_position[1] and not in_long_position, "Long Exit", shape.xcross,
         location.abovebar, color.new(color.orange, 0), size=size.small)

plotshape(show_exits and in_short_position[1] and not in_short_position, "Short Exit", shape.xcross,
         location.belowbar, color.new(color.orange, 0), size=size.small)

// ═════════════════════════════════════════════════════════
// STOP LOSS LEVELS
// ═════════════════════════════════════════════════════════

// Plot SL lines
plot(show_sl and in_long_position ? long_sl : na, "Long SL", 
     color.red, linewidth=2, style=plot.style_linebr)

plot(show_sl and in_short_position ? short_sl : na, "Short SL", 
     color.red, linewidth=2, style=plot.style_linebr)

// NOTE: SL hit markers are disabled as they are covered by the unified exit signal.

// ═════════════════════════════════════════════════════════
// INFO TABLE
// ═════════════════════════════════════════════════════════

var table info = table.new(position.top_right, 2, 9, border_width=1)

if barstate.islast
    table.cell(info, 0, 0, "CHoCH/BOS Complete TP", bgcolor=color.new(color.blue, 0), text_color=color.white)
    table.cell(info, 1, 0, "", bgcolor=color.new(color.blue, 0), text_color=color.white)
    
    table.cell(info, 0, 1, "Trend", text_halign=text.align_left)
    trend_text = trend == 2 ? "BULLISH" : trend == 1 ? "BEARISH" : "NEUTRAL"
    trend_color = trend == 2 ? color.lime : trend == 1 ? color.red : color.gray
    table.cell(info, 1, 1, trend_text, text_halign=text.align_right, text_color=trend_color)
    
    table.cell(info, 0, 2, "Position", text_halign=text.align_left)
    pos_text = in_long_position ? "LONG" : in_short_position ? "SHORT" : "FLAT"
    pos_color = in_long_position ? color.lime : in_short_position ? color.red : color.gray
    table.cell(info, 1, 2, pos_text, text_halign=text.align_right, text_color=pos_color)
    
    table.cell(info, 0, 3, "ROI Target", text_halign=text.align_left)
    roi_text = str.tostring(current_roi_target, "#.#") + "%"
    table.cell(info, 1, 3, roi_text, text_halign=text.align_right, text_color=color.blue)
    
    table.cell(info, 0, 4, "FVG Filter", text_halign=text.align_left)
    fvg_text = require_fvg ? (fvg_bull_filled or fvg_bear_filled ? "RETESTED" : "WAITING") : "DISABLED"
    fvg_color = require_fvg ? (fvg_bull_filled or fvg_bear_filled ? color.lime : color.orange) : color.gray
    table.cell(info, 1, 4, fvg_text, text_halign=text.align_right, text_color=fvg_color)
    
    table.cell(info, 0, 5, "Stop Loss", text_halign=text.align_left)
    table.cell(info, 1, 5, str.tostring(stop_loss_pct) + "%", text_halign=text.align_right)
    
    table.cell(info, 0, 6, "Last High", text_halign=text.align_left)
    high_text = not na(last_pivot_high) ? str.tostring(last_pivot_high, format.mintick) : "N/A"
    table.cell(info, 1, 6, high_text, text_halign=text.align_right, text_color=color.red)
    
    table.cell(info, 0, 7, "Last Low", text_halign=text.align_left)
    low_text = not na(last_pivot_low) ? str.tostring(last_pivot_low, format.mintick) : "N/A"
    table.cell(info, 1, 7, low_text, text_halign=text.align_right, text_color=color.lime)

// ═════════════════════════════════════════════════════════
// ALERTS
// ═════════════════════════════════════════════════════════

alertcondition(long_condition, "Long Entry")
alertcondition(short_condition, "Short Entry")
alertcondition(long_exit_roi, "Long ROI Exit")
alertcondition(short_exit_roi, "Short ROI Exit")
alertcondition(long_exit_choch, "Long CHoCH Exit")
alertcondition(short_exit_choch, "Short CHoCH Exit")
alertcondition(fvg_bull, "Bullish FVG")
alertcondition(fvg_bear, "Bearish FVG")