// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © LudoGH68 (SMC Base) + LonesomeTheBlue (ZigZag with Fibonacci) + LuxAlgo (SFP + MST) + OmegaTools (Smooth Trail) + Claude Code (Strategy Integration)
//@version=6
strategy("CHoCH/BOS + Fibo + SFP + MST + Smooth Trail", shorttitle="CHoCH Complete", overlay=true, initial_capital=12, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.075, pyramiding=0, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ============================================================================
// ZIGZAG WITH FIBONACCI LEVELS (Adapted from LonesomeTheBlue)
// ============================================================================

// ZigZag Parameters
prd = input.int(defval=23, title="ZigZag Period", minval=2, maxval=50, group="ZigZag")
showzigzag = input.bool(defval=true, title="Show Zig Zag", group="ZigZag")
showfibo = input.bool(defval=true, title="Show Fibonacci Ratios", group="ZigZag")
labelcol = input.color(defval=color.blue, title="Text Color for Fibo Levels", group="ZigZag")
fibolinecol = input.color(defval=color.lime, title="Line Color for Fibo Levels", group="ZigZag")
upcol = input.color(defval=color.lime, title="Zigzag Up Color", group="ZigZag", inline="zzcol")
dncol = input.color(defval=color.red, title="Down Color", group="ZigZag", inline="zzcol")
labelloc = input.string(defval="Right", title="Fibo Label Location", options=["Left", "Right", "Above Right"], group="ZigZag")

// Fibonacci Level Toggles
enable236 = input.bool(defval=false, title="Enable Level 0.236", group="Fibonacci Levels")
enable382 = input.bool(defval=true, title="Enable Level 0.382", group="Fibonacci Levels")
enable500 = input.bool(defval=true, title="Enable Level 0.500", group="Fibonacci Levels")
enable618 = input.bool(defval=true, title="Enable Level 0.618", group="Fibonacci Levels")
enable786 = input.bool(defval=false, title="Enable Level 0.786", group="Fibonacci Levels")

// Build Fibonacci ratios array
var fibo_ratios = array.new<float>(0)
var shownlevels = 1

if barstate.isfirst
    array.push(fibo_ratios, 0.000)
    if enable236
        array.push(fibo_ratios, 0.236)
        shownlevels += 1
    if enable382
        array.push(fibo_ratios, 0.382)
        shownlevels += 1
    if enable500
        array.push(fibo_ratios, 0.500)
        shownlevels += 1
    if enable618
        array.push(fibo_ratios, 0.618)
        shownlevels += 1
    if enable786
        array.push(fibo_ratios, 0.786)
        shownlevels += 1
    array.push(fibo_ratios, 1.000)

// ZigZag calculation using ta.highestbars/lowestbars (v6 compatible)
float ph = ta.highestbars(high, prd) == 0 ? high : na
float pl = ta.lowestbars(low, prd) == 0 ? low : na

var int dir = 0
dir := not na(ph) and na(pl) ? 1 : not na(pl) and na(ph) ? -1 : dir

var int max_array_size = 10
var array<float> zigzag = array.new<float>(0)
array<float> oldzigzag = array.copy(zigzag)

// Functions to manage zigzag array
add_to_zigzag(float value, int bindex) =>
    array.unshift(zigzag, bindex)
    array.unshift(zigzag, value)
    if array.size(zigzag) > max_array_size
        array.pop(zigzag)
        array.pop(zigzag)

update_zigzag(float value, int bindex) =>
    if array.size(zigzag) == 0
        add_to_zigzag(value, bindex)
    else
        if (dir == 1 and value > array.get(zigzag, 0)) or (dir == -1 and value < array.get(zigzag, 0))
            array.set(zigzag, 0, value)
            array.set(zigzag, 1, bindex)
    0.0

bool dirchanged = dir != dir[1]

if not na(ph) or not na(pl)
    if dirchanged
        add_to_zigzag(dir == 1 ? ph : pl, bar_index)
    else
        update_zigzag(dir == 1 ? ph : pl, bar_index)

// Draw ZigZag lines
if showzigzag and array.size(zigzag) >= 4 and array.size(oldzigzag) >= 4
    var line zzline = na
    if array.get(zigzag, 0) != array.get(oldzigzag, 0) or array.get(zigzag, 1) != array.get(oldzigzag, 1)
        if array.get(zigzag, 2) == array.get(oldzigzag, 2) and array.get(zigzag, 3) == math.round(array.get(oldzigzag, 3))
            line.delete(zzline)
        zzline := line.new(
             x1=math.round(array.get(zigzag, 1)),
             y1=array.get(zigzag, 0),
             x2=math.round(array.get(zigzag, 3)),
             y2=array.get(zigzag, 2),
             color=dir == 1 ? upcol : dncol,
             width=2)

// Draw Fibonacci levels - ONLY for current zigzag move (last pivot to current price)
var array<line> fibolines = array.new<line>(0)
var array<label> fibolabels = array.new<label>(0)
var int lastFiboPivotBar = na

if showfibo and array.size(zigzag) >= 4
    // Get last two confirmed pivots (in chronological order)
    float pivot1_price = array.get(zigzag, 2)      // First pivot (older)
    int pivot1_bar = math.round(array.get(zigzag, 3))
    float pivot2_price = array.get(zigzag, 0)      // Second pivot (newer)
    int pivot2_bar = math.round(array.get(zigzag, 1))

    // Determine start and end bars (chronologically)
    int startBar = pivot1_bar  // Older pivot
    int endBar = pivot2_bar    // Newer pivot

    // Determine direction and calculate fibonacci accordingly
    bool isBullishMove = pivot2_price > pivot1_price  // Price went up
    float basePrice = isBullishMove ? pivot2_price : pivot2_price  // Start from the newest pivot
    float targetPrice = isBullishMove ? pivot1_price : pivot1_price  // Retrace towards the older pivot
    float diff = math.abs(pivot2_price - pivot1_price)

    // Clear and redraw only when pivot changes
    if na(lastFiboPivotBar) or pivot2_bar != lastFiboPivotBar
        // Delete old drawings
        if array.size(fibolines) > 0
            for i = 0 to array.size(fibolines) - 1
                line.delete(array.get(fibolines, i))
                label.delete(array.get(fibolabels, i))
            array.clear(fibolines)
            array.clear(fibolabels)

        lastFiboPivotBar := pivot2_bar

        // Create new lines and labels for each fibonacci level
        for x = 0 to array.size(fibo_ratios) - 1
            float fiboRatio = array.get(fibo_ratios, x)

            // Skip 0.000 and 1.000 levels
            if fiboRatio == 0.000 or fiboRatio == 1.000
                continue

            // Calculate fibonacci level based on direction
            // For bullish move (LOW to HIGH): retracement levels go DOWN from HIGH
            // For bearish move (HIGH to LOW): retracement levels go UP from LOW
            float fiboLevel = isBullishMove ? (pivot2_price - diff * fiboRatio) : (pivot2_price + diff * fiboRatio)

            // Determine color based on fibonacci level
            color lineColor = fibolinecol  // default
            if fiboRatio == 0.618
                lineColor := color.green
            else if fiboRatio == 0.500
                lineColor := color.red
            else if fiboRatio == 0.382
                lineColor := #2962ff  // Smooth Trail color

            // Create line that extends 25 bars to the right
            array.push(fibolines,
                 line.new(
                     x1=startBar,
                     y1=fiboLevel,
                     x2=endBar + 25,
                     y2=fiboLevel,
                     color=lineColor,
                     width=2))

            // Create label with ratio and price (simple, at line end)
            string labelText = str.tostring(fiboRatio, '#.###') + ' (' + str.tostring(fiboLevel, format.mintick) + ')'

            array.push(fibolabels,
                 label.new(
                     x=endBar + 25,
                     y=fiboLevel,
                     text=labelText,
                     textcolor=lineColor,
                     style=label.style_label_left,
                     color=color.new(color.white, 100),
                     size=size.small,
                     yloc=yloc.price))

// ============================================================================
// HULL MOVING AVERAGE INPUTS & CALCULATION
// ============================================================================

// Hull Moving Average Filter Inputs
hma_length = input.int(200, "HMA Length", minval=1, maxval=500, group="HMA Filter", tooltip="Hull Moving Average period")
use_hma_filter_long = input.bool(false, "Enable HMA Filter for Longs", group="HMA Filter", tooltip="Require price to touch HMA before long entry")
use_hma_filter_short = input.bool(false, "Enable HMA Filter for Shorts", group="HMA Filter", tooltip="Require price to touch HMA before short entry")
show_hma = input.bool(true, "Show HMA on Chart", group="HMA Filter")

// Hull Moving Average formula: HMA = WMA(2*WMA(n/2) - WMA(n), sqrt(n))
hma_wma1 = ta.wma(close, hma_length / 2)
hma_wma2 = ta.wma(close, hma_length)
hma_diff = 2 * hma_wma1 - hma_wma2
hma = ta.wma(hma_diff, math.round(math.sqrt(hma_length)))

// Plot HMA
plot(show_hma ? hma : na, "HMA", color=color.blue, linewidth=2)

// ============================================================================
// SWING FAILURE PATTERN (SFP) - Adapted from LuxAlgo
// ============================================================================

// SFP Inputs
sp = '            '
sfp_len = input.int(5, 'Swings', minval=1, group='SFP Settings')
sfp_bull = input.bool(true, 'Bullish SFP', group='SFP Settings')
sfp_bear = input.bool(true, 'Bearish SFP', group='SFP Settings')

sfp_iVal = input.string('None', 'Validation' + sp + '   ', group='SFP Volume Validation', options=['Volume outside swing < Threshold', 'Volume outside swing > Threshold', 'None'])
sfp_percent = input.float(25, 'Volume Threshold %', inline='valy', group='SFP Volume Validation', tooltip='% of Total Volume', minval=0, maxval=100)
sfp_auto = input.bool(true, '', inline='auto', group='SFP Volume Validation')
sfp_mlt = input.int(50, '      Auto' + sp, inline='auto', group='SFP Volume Validation')
sfp_res = input.timeframe('', sp + '   LTF' + sp + '  ', inline='ltf', group='SFP Volume Validation')
sfp_prem = input.bool(false, '    Premium', group='SFP Volume Validation', tooltip='Premium Plan or higher')
sfp_showDash = input.bool(false, 'Show Dashboard', group='SFP Dashboard')
sfp_dashLoc = input.string('Top Right', 'Location', options=['Top Right', 'Bottom Right', 'Bottom Left'], group='SFP Dashboard')
sfp_textSize = input.string('Normal', 'Size', options=['Tiny', 'Small', 'Normal'], group='SFP Dashboard')
sfp_dSwingLine = input.bool(true, 'Swing Lines', group='SFP Style')
sfp_dOpposLine = input.bool(true, 'Confirmation Lines', group='SFP Style')
sfp_dSFP_Line = input.bool(true, 'Swing Failure Wick', group='SFP Style')
sfp_dSFP_Label = input.bool(true, 'Swing Failure Label', group='SFP Style')
sfp_colBl = input.color(#089981, 'Lines / Labels', inline='lin', group='SFP Style')
sfp_colBr = input.color(#f23645, '', inline='lin', group='SFP Style', tooltip='Bullish/Bearish')
sfp_colBl2 = input.color(#08998180, 'SFP Wicks      ', inline='wic', group='SFP Style')
sfp_colBr2 = input.color(#f2364580, '', inline='wic', group='SFP Style', tooltip='Wick outside Swing, Bullish/Bearish')

// SFP User Defined Types
//@type Custom type for tracking pivot information
type piv
    float swing_prc   // price
    int swing_bix     // bar_index
    float oppos_prc   // price
    int oppos_bix     // bar_index
    bool active
    bool confirmed
    line swing_line
    line oppos_line
    line wicky_line
    label wicky_label

//@type Custom type for swing tracking
type swing
    int bix
    float prc

// SFP Variables
n = bar_index
INV = color(na)
FGc = chart.fg_color

sfp_table_position = sfp_dashLoc == 'Bottom Left' ? position.bottom_left : sfp_dashLoc == 'Top Right' ? position.top_right : position.bottom_right

sfp_table_size = sfp_textSize == 'Tiny' ? size.tiny : sfp_textSize == 'Small' ? size.small : size.normal

var sfp_tb = table.new(sfp_table_position, 2, 3, bgcolor=#1e222d, border_color=#373a46, border_width=1, frame_color=#373a46, frame_width=1)

var swingH = swing.new()
var swingL = swing.new()
var pivH = piv.new()
var pivL = piv.new()

sfp_validate = sfp_iVal != 'None'
sfp_valHigher = sfp_iVal == 'Volume outside swing > Threshold'
sfp_valLower = sfp_iVal == 'Volume outside swing < Threshold'

// SFP Method
n(float piv) =>
    bool out = not na(piv)

// SFP Execution
sfp_tfS = timeframe.in_seconds(sfp_res)
sfp_tfC = timeframe.in_seconds(timeframe.period)
sfp_rs = sfp_auto ? sfp_tfC / sfp_mlt : sfp_tfS
if not sfp_validate
    sfp_res := timeframe.period
else
    sfp_rs := sfp_prem ? sfp_rs : math.max(60, sfp_rs)
    sfp_res := timeframe.from_seconds(math.min(sfp_tfC, sfp_rs))

sfp_ph = ta.pivothigh(sfp_len, 1)
sfp_pl = ta.pivotlow(sfp_len, 1)

[ltf_close, ltf_volume] = request.security_lower_tf(syminfo.tickerid, sfp_res, [close, volume])

ltf_size = ltf_close.size()

if sfp_validate
    if ltf_size > 0 and ltf_size[1] == 0
        line.new(n, close, n, close + syminfo.mintick, color=color.silver, style=line.style_dotted, extend=extend.both)

// Bearish SFP Pattern
if sfp_bear
    if n(sfp_ph)
        swingH.bix := n - 1
        swingH.prc := sfp_ph

    sw = swingH.prc
    bx = swingH.bix
    if high > sw and open < sw and close < sw
        valid = true
        if sfp_validate
            if ltf_close.size() > 0
                outsideVolume = 0.
                totalVolume = ltf_volume.sum()
                for j = 0 to ltf_close.size() - 1
                    if ltf_close.get(j) > sw
                        outsideVolume += ltf_volume.get(j)
                if (sfp_valHigher ? 100 / totalVolume * outsideVolume < sfp_percent : 100 / totalVolume * outsideVolume > sfp_percent)
                    valid := false

        if valid
            opposL = sw
            opposB = n

            for i = 1 to n - bx - 1
                if low[i] < opposL
                    opposL := low[i]
                    opposB := n - i

            if not pivH.confirmed
                pivH.swing_line.delete()
                pivH.oppos_line.delete()
                pivH.wicky_line.delete()
                pivH.wicky_label.delete()

            pivH := piv.new(sw, bx, opposL, opposB, true, false)

            if sfp_dSwingLine
                pivH.swing_line := line.new(bx, sw, n, sw, color=sfp_colBr)
            if sfp_dOpposLine
                pivH.oppos_line := line.new(opposB, opposL, n, opposL, color=sfp_colBr, style=line.style_dotted)
            if sfp_dSFP_Line
                pivH.wicky_line := line.new(n, high, n, sw, color=sfp_colBr2, width=3)
            if sfp_dSFP_Label
                pivH.wicky_label := label.new(n, high, style=label.style_label_down, text='SFP', textcolor=sfp_colBr, color=INV, size=size.normal)

    if pivH.active and not pivH.confirmed
        pivH.swing_line.set_x2(n)
        pivH.oppos_line.set_x2(n)

        if close < pivH.oppos_prc
            pivH.confirmed := true

            if pivH.wicky_label.get_x() == n
                pivH.wicky_label.set_text('SFP\n▼')
            else
                label.new(n, high, style=label.style_label_down, text='▼', textcolor=sfp_colBr, color=INV, size=size.normal)

    if n - pivH.swing_bix > 500 or close > pivH.swing_prc
        pivH.active := false
        if not pivH.confirmed
            pivH.swing_line.delete()
            pivH.oppos_line.delete()
            pivH.wicky_line.delete()
            pivH.wicky_label.delete()

// Bullish SFP Pattern
if sfp_bull
    if n(sfp_pl)
        swingL.bix := n - 1
        swingL.prc := sfp_pl

    sw = swingL.prc
    bx = swingL.bix
    if low < sw and open > sw and close > sw
        valid = true
        if sfp_validate
            if ltf_close.size() > 0
                outsideVolume = 0.
                totalVolume = ltf_volume.sum()
                for j = 0 to ltf_close.size() - 1
                    if ltf_close.get(j) < sw
                        outsideVolume += ltf_volume.get(j)
                if (sfp_valHigher ? 100 / totalVolume * outsideVolume < sfp_percent : 100 / totalVolume * outsideVolume > sfp_percent)
                    valid := false
        if valid
            opposH = sw
            opposB = n

            for i = 1 to n - bx - 1
                if high[i] > opposH
                    opposH := high[i]
                    opposB := n - i

            if not pivL.confirmed
                pivL.swing_line.delete()
                pivL.oppos_line.delete()
                pivL.wicky_line.delete()
                pivL.wicky_label.delete()

            pivL := piv.new(sw, bx, opposH, opposB, true, false)

            if sfp_dSwingLine
                pivL.swing_line := line.new(bx, sw, n, sw, color=sfp_colBl)
            if sfp_dOpposLine
                pivL.oppos_line := line.new(opposB, opposH, n, opposH, color=sfp_colBl, style=line.style_dotted)
            if sfp_dSFP_Line
                pivL.wicky_line := line.new(n, low, n, sw, color=sfp_colBl2, width=3)
            if sfp_dSFP_Label
                pivL.wicky_label := label.new(n, low, style=label.style_label_up, text='SFP', textcolor=sfp_colBl, color=INV, size=size.normal)

    if pivL.active and not pivL.confirmed
        pivL.swing_line.set_x2(n)
        pivL.oppos_line.set_x2(n)

        if close > pivL.oppos_prc
            pivL.confirmed := true

            if pivL.wicky_label.get_x() == n
                pivL.wicky_label.set_text('▲\nSFP')
            else
                label.new(n, low, style=label.style_label_up, text='▲', textcolor=sfp_colBl, color=INV, size=size.normal)

    if n - pivL.swing_bix > 500 or close < pivL.swing_prc
        pivL.active := false
        if not pivL.confirmed
            pivL.swing_line.delete()
            pivL.oppos_line.delete()
            pivL.wicky_line.delete()
            pivL.wicky_label.delete()

// SFP Dashboard
if barstate.islast and sfp_validate and sfp_showDash
    sfp_tb.cell(0, 0, str.format("LTF: {0}", sfp_res), text_color=color.white, text_size=sfp_table_size)

// ============================================================================
// SMOOTH TRAIL - Adapted from OmegaTools
// ============================================================================

// Smooth Trail Inputs
st_enabled = input.bool(true, "Enable Smooth Trail", group="Smooth Trail")
st_use_as_confirmation = input.bool(false, "Use as Entry Confirmation", group="Smooth Trail", tooltip="Require price to touch Smooth Trail zone before entry")
st_multiplier = input.float(1.00, "Multiplier", minval=0.1, maxval=10, step=0.1, group="Smooth Trail")
st_length = input.int(34, "Length", minval=1, maxval=200, group="Smooth Trail")
st_zone_width = input.float(1.00, "Zone Width", minval=0.1, maxval=5, step=0.1, group="Smooth Trail")
st_show_opposite_area = input.bool(false, "Show Opposite Area", group="Smooth Trail")
st_show_crossing_lines = input.bool(false, "Show Crossing Lines", group="Smooth Trail")

// Smooth Trail Calculation
st_atrs = ta.atr(100)
[st_supertrend, st_direction] = ta.supertrend(math.round(math.avg(7, st_multiplier)), st_length * 2)
st_hullup = ta.hma(high, math.round(math.avg(21, st_length))) + st_atrs * math.round(st_multiplier / 2.5)
st_hulldown = ta.hma(low, math.round(math.avg(21, st_length))) - st_atrs * math.round(st_multiplier / 2.5)
st_hline = ta.highest(close, st_length) + st_atrs
st_lline = ta.lowest(close, st_length) + st_atrs

st_supert = 0.00
st_supert := if close > st_supertrend
    math.avg(st_supertrend, st_supertrend, st_supertrend, st_hulldown, st_lline)
else if close < st_supertrend
    math.avg(st_supertrend, st_supertrend, st_supertrend, st_hullup, st_hline)
else
    nz(st_supert[1])

st_supert2 = 0.00
st_supert2 := if close > st_supert
    st_supert + st_atrs * st_zone_width
else if close < st_supert
    st_supert - st_atrs * st_zone_width
else
    nz(st_supert2[1])

// Target calculation
st_mid = ta.ema(close, 21)
st_dist = (st_supert - st_mid) * st_zone_width
st_tpl = ta.sma(st_mid - st_dist, 2)

// Visual elements
st_tool = st_direction > 0 or st_direction < 0
st_toolx = st_show_crossing_lines ? true : (st_direction < 0 and st_direction[1] < 0) or (st_direction > 0 and st_direction[1] > 0)

st_bullish = close > st_supert
st_line_color = st_bullish ? #2962ff : #e91e63
st_fill_color = st_bullish ? color.new(#2962ff, 80) : color.new(#e91e63, 80)

st_tool12 = plot(st_enabled and st_toolx ? st_supert : na, "ST Extreme line", color=st_line_color, style=plot.style_linebr, linewidth=2)
st_tool2 = plot(st_enabled and st_toolx ? st_supert2 : na, "ST Zone line", color=color.new(color.gray, 100), display=display.none, editable=false, style=plot.style_linebr)
fill(st_tool12, st_tool2, color=st_enabled ? st_fill_color : na, fillgaps=false, title="ST Zone Fill")

plot(st_enabled and st_toolx and st_show_opposite_area ? st_tpl : na, "ST Target", st_line_color, style=plot.style_linebr)

// Smooth Trail zone touch detection
var bool st_zone_touched_long = false   // Price touched ST bullish zone
var bool st_zone_touched_short = false  // Price touched ST bearish zone

// Detect zone touch for LONG: price in bullish zone (between supert and supert2 when bullish)
if st_enabled and st_use_as_confirmation
    if st_bullish
        // Bullish zone: price between supert (extreme) and supert2 (zone)
        if close >= st_supert and close <= st_supert2
            st_zone_touched_long := true
    else
        // Reset if not in bullish trend
        st_zone_touched_long := false

// Detect zone touch for SHORT: price in bearish zone (between supert2 and supert when bearish)
if st_enabled and st_use_as_confirmation
    if not st_bullish
        // Bearish zone: price between supert2 (zone) and supert (extreme)
        if close <= st_supert and close >= st_supert2
            st_zone_touched_short := true
    else
        // Reset if not in bearish trend
        st_zone_touched_short := false

// ============================================================================
// MARKET STRUCTURE TARGETS (MST) - Dynamic TP Calculation
// ============================================================================

// MST Inputs
mst_enabled = input.bool(true, "Enable MST Targets", group="MST - Market Structure Targets")
mst_exit_mode = input.string("BOS Counting", "Exit Mode", options=["Visual Only", "Simple TP", "Multiple TP", "BOS Counting"], group="MST - Market Structure Targets", tooltip="Visual Only: Show targets only\nSimple TP: Close 100% at first target\nMultiple TP: Close 50% at CHoCH, 50% at BOS\nBOS Counting: Close at 1st BOS (TP1%), 2nd BOS (TP2%), CHoCH (rest)")
mst_show_choch_targets = input.bool(true, "Show CHoCH Targets", group="MST - Market Structure Targets", tooltip="Calculate targets for CHoCH (structure shift)")
mst_show_bos_targets = input.bool(true, "Show BOS Targets", group="MST - Market Structure Targets", tooltip="Calculate targets for BOS (continuation)")
mst_choch_percentage = input.float(100.0, "CHoCH Target %", minval=10, maxval=300, step=10, group="MST - Market Structure Targets", tooltip="Projection percentage for CHoCH targets")
mst_bos_percentage = input.float(100.0, "BOS Target %", minval=10, maxval=300, step=10, group="MST - Market Structure Targets", tooltip="Projection percentage for BOS targets")
mst_max_duration = input.int(300, "Max Target Duration", minval=50, maxval=1000, group="MST - Market Structure Targets", tooltip="Maximum bars before target expires")
mst_tp1_percentage = input.float(50.0, "BOS Counting: TP1 %", minval=10, maxval=90, step=5, group="MST - Market Structure Targets", tooltip="% of position to close at 1st BOS after entry")
mst_tp2_percentage = input.float(30.0, "BOS Counting: TP2 %", minval=10, maxval=70, step=5, group="MST - Market Structure Targets", tooltip="% of position to close at 2nd BOS after entry")
mst_move_to_be = input.bool(true, "BOS Counting: Move to BE after TP1", group="MST - Market Structure Targets", tooltip="Move stop loss to breakeven after TP1 hit")
mst_choch_bull_color = input.color(#089981, "CHoCH Bullish", inline="choch", group="MST - Market Structure Targets")
mst_choch_bear_color = input.color(#f23645, "CHoCH Bearish", inline="choch", group="MST - Market Structure Targets")
mst_bos_bull_color = input.color(color.new(#089981, 50), "BOS Bullish", inline="bos", group="MST - Market Structure Targets")
mst_bos_bear_color = input.color(color.new(#f23645, 50), "BOS Bearish", inline="bos", group="MST - Market Structure Targets")

// MST User Defined Types
//@type Target tracking for MST
type mst_target
    line target_line       // Horizontal target line
    line vertical_line     // Vertical line from structure to target
    bool active           // Is target still active?
    int created_bar       // Bar index when target was created
    float target_price    // Target price level

// MST Variables
var array<mst_target> mst_choch_bull_targets = array.new<mst_target>()
var array<mst_target> mst_choch_bear_targets = array.new<mst_target>()
var array<mst_target> mst_bos_bull_targets = array.new<mst_target>()
var array<mst_target> mst_bos_bear_targets = array.new<mst_target>()

// MST Methods
//@function Calculate and create bullish target
//@param target_array Array to store target
//@param structure_bar Bar index of structure break
//@param structure_price Price level of structure break
//@param percentage Projection percentage
//@param color_line Color for target lines
mst_create_bull_target(array<mst_target> target_array, int structure_bar, float structure_price, float percentage, color color_line) =>
    // Find lowest point from structure_bar to current bar
    float lowest_price = high
    int bars_back = bar_index - structure_bar

    for i = 0 to bars_back
        if low[i] < lowest_price
            lowest_price := low[i]

    // Calculate target: HighLevel + (HighLevel - LowestPoint) × Percentage
    float price_diff = structure_price - lowest_price
    float target_price = structure_price + (price_diff * percentage / 100)

    // Create horizontal target line (extends to the right)
    line target_ln = line.new(
         structure_bar, target_price,
         bar_index + 10, target_price,
         color=color_line,
         style=line.style_dashed,
         width=2)

    // Create vertical projection line
    line vertical_ln = line.new(
         bar_index, structure_price,
         bar_index, target_price,
         color=color_line,
         style=line.style_dotted,
         width=1)

    // Store target (mark as active only if target is above current price)
    bool is_active = target_price > close
    array.push(target_array, mst_target.new(
         target_ln,
         vertical_ln,
         is_active,
         bar_index,
         target_price))

//@function Calculate and create bearish target
//@param target_array Array to store target
//@param structure_bar Bar index of structure break
//@param structure_price Price level of structure break
//@param percentage Projection percentage
//@param color_line Color for target lines
mst_create_bear_target(array<mst_target> target_array, int structure_bar, float structure_price, float percentage, color color_line) =>
    // Find highest point from structure_bar to current bar
    float highest_price = low
    int bars_back = bar_index - structure_bar

    for i = 0 to bars_back
        if high[i] > highest_price
            highest_price := high[i]

    // Calculate target: LowLevel - (HighestPoint - LowLevel) × Percentage
    float price_diff = highest_price - structure_price
    float target_price = structure_price - (price_diff * percentage / 100)

    // Create horizontal target line (extends to the right)
    line target_ln = line.new(
         structure_bar, target_price,
         bar_index + 10, target_price,
         color=color_line,
         style=line.style_dashed,
         width=2)

    // Create vertical projection line
    line vertical_ln = line.new(
         bar_index, structure_price,
         bar_index, target_price,
         color=color_line,
         style=line.style_dotted,
         width=1)

    // Store target (mark as active only if target is below current price)
    bool is_active = target_price < close
    array.push(target_array, mst_target.new(
         target_ln,
         vertical_ln,
         is_active,
         bar_index,
         target_price))

//@function Update targets and check if reached or expired
//@param target_array Array of targets to update
//@param is_bullish True for bullish targets, false for bearish
mst_update_targets(array<mst_target> target_array, bool is_bullish) =>
    if array.size(target_array) > 0
        for tgt in target_array
            if tgt.active
                // Extend target line to current bar
                tgt.target_line.set_x2(bar_index)

                // Check if target reached
                bool target_hit = is_bullish ? (high >= tgt.target_price) : (low <= tgt.target_price)

                if target_hit
                    // Target reached - deactivate
                    tgt.active := false

                // Check if target expired (max duration)
                if bar_index - tgt.created_bar > mst_max_duration
                    // Target expired - delete and deactivate
                    tgt.target_line.delete()
                    tgt.vertical_line.delete()
                    tgt.active := false

// ============================================================================
// SMC STRUCTURE DETECTION (Based on ZigZag Pivots)
// ============================================================================

// Structure Display Settings
showBOS = input.bool(true, "Show BOS", group="Structure Labels")
showCHoCH = input.bool(true, "Show CHoCH", group="Structure Labels")
structHistoryNbr = input.int(20, "Number of breaks to show", minval=1, maxval=100, group="Structure Labels")
minBarsBetweenBreaks = input.int(5, "Min bars between breaks", minval=1, maxval=50, group="Structure Labels", tooltip="Minimum candles between BOS/CHoCH detections to reduce noise")

// Colors
bullishBosColor = input.color(color.silver, "Bullish BOS Color", group="Colors")
bearishBosColor = input.color(color.silver, "Bearish BOS Color", group="Colors")
bullishChochColor = input.color(color.yellow, "Bullish CHoCH Color", group="Colors")
bearishChochColor = input.color(color.yellow, "Bearish CHoCH Color", group="Colors")

// Risk Management
stoploss_pct = input.float(-5.8, "Stop Loss %", minval=-10, maxval=-1, step=0.1, group="Strategy")

// Trailing Stop (validated with hyperopt)
use_trailing = input.bool(false, "Enable Trailing Stop", group="Strategy", tooltip="Activate trailing stop when trade is in profit")
trailing_offset = input.float(2.0, "Trailing Offset %", minval=0.5, maxval=10, step=0.1, group="Strategy", tooltip="Activate trailing when profit > this %")
trailing_distance = input.float(1.0, "Trailing Distance %", minval=0.1, maxval=5, step=0.1, group="Strategy", tooltip="Keep stop this % below highest profit")

// Exit Options
exit_on_bos_opposite = input.bool(true, "Require BOS Confirmation to Exit", group="Strategy", tooltip="More conservative: Wait for BOS confirmation after CHoCH before exiting (CHoCH → wait BOS → exit)")

// Enable/Disable Trade Directions
enable_longs = input.bool(true, "Enable Long Trades", group="Strategy", tooltip="Allow opening long positions")
enable_shorts = input.bool(true, "Enable Short Trades", group="Strategy", tooltip="Allow opening short positions")

// Visual Signals
showEntrySignals = input.bool(true, "Show Entry Signals", group="Strategy")
showExitSignals = input.bool(true, "Show Exit Signals", group="Strategy")
showBackgroundStates = input.bool(false, "Show Waiting States Background", group="Strategy")

// Structure tracking variables
var float lastPivotHigh = na
var float lastPivotLow = na
var int lastPivotHighBar = na
var int lastPivotLowBar = na
var int structureDirection = 0  // 0=neutral, 1=bearish (downtrend), 2=bullish (uptrend)
var int lastBreakBar = 0  // Track last break detection to avoid noise

var array<line> structureLines = array.new<line>(0)
var array<label> structureLabels = array.new<label>(0)

// Trailing stop tracking
var float max_profit_long = 0.0
var float max_profit_short = 0.0

// Exit confirmation tracking (for BOS confirmation mode)
var bool waiting_exit_long_confirmation = false
var bool waiting_exit_short_confirmation = false

// Track position state to detect closes
var float prev_position_size = 0.0

// Exit type tracking for markers
var bool exit_by_stoploss_long = false
var bool exit_by_stoploss_short = false
var bool exit_by_trailing_long = false
var bool exit_by_trailing_short = false
var bool exit_by_mst_tp1_long = false
var bool exit_by_mst_tp1_short = false
var bool exit_by_mst_tp2_long = false
var bool exit_by_mst_tp2_short = false

// MST TP tracking (reset when entering new position)
var bool mst_tp1_hit_long = false   // CHoCH target hit for long
var bool mst_tp2_hit_long = false   // BOS target hit for long
var bool mst_tp1_hit_short = false  // CHoCH target hit for short
var bool mst_tp2_hit_short = false  // BOS target hit for short

// BOS Counting mode tracking
var int bos_count_long = 0   // Count of BOS bullish after long entry
var int bos_count_short = 0  // Count of BOS bearish after short entry

// HMA filter tracking
var bool hma_touched_long = false   // Tracks if price touched HMA while waiting for long entry
var bool hma_touched_short = false  // Tracks if price touched HMA while waiting for short entry

// Signal variables
var bool choch_bullish = false
var bool choch_bearish = false
var bool bos_bullish = false
var bool bos_bearish = false

// Reset signals every bar
choch_bullish := false
choch_bearish := false
bos_bullish := false
bos_bearish := false

// Reset exit markers
exit_by_stoploss_long := false
exit_by_stoploss_short := false
exit_by_trailing_long := false
exit_by_trailing_short := false
exit_by_mst_tp1_long := false
exit_by_mst_tp1_short := false
exit_by_mst_tp2_long := false
exit_by_mst_tp2_short := false

// Process pivot detections from ZigZag
// When a new pivot HIGH is confirmed
if not na(ph)
    int pivotBar = bar_index
    float pivotPrice = ph

    // Manage history
    if array.size(structureLines) >= structHistoryNbr * 2
        line.delete(array.get(structureLines, 0))
        label.delete(array.get(structureLabels, 0))
        array.remove(structureLines, 0)
        array.remove(structureLabels, 0)

    // Only detect if enough bars passed since last break (reduce noise)
    bool canDetectBreak = (bar_index - lastBreakBar) >= minBarsBetweenBreaks

    // Determine if this is CHoCH or BOS
    if not na(lastPivotHigh) and canDetectBreak
        if pivotPrice > lastPivotHigh
            // Price broke above previous high
            if structureDirection == 2
                // Already bullish → BOS (continuation)
                bos_bullish := true
                lastBreakBar := bar_index
                // Visual elements (optional)
                if showBOS
                    array.push(structureLines, line.new(lastPivotHighBar, lastPivotHigh, pivotBar, lastPivotHigh, color=bullishBosColor, style=line.style_solid, width=1))
                    array.push(structureLabels, label.new((pivotBar + lastPivotHighBar) / 2, lastPivotHigh, "BOS", style=label.style_none, textcolor=bullishBosColor))
                // Create MST target for BOS bullish
                if mst_enabled and mst_show_bos_targets
                    mst_create_bull_target(mst_bos_bull_targets, lastPivotHighBar, lastPivotHigh, mst_bos_percentage, mst_bos_bull_color)
            else if structureDirection != 2
                // Was bearish/neutral → CHoCH (reversal)
                choch_bullish := true
                structureDirection := 2
                lastBreakBar := bar_index
                // Visual elements (optional)
                if showCHoCH
                    array.push(structureLines, line.new(lastPivotHighBar, lastPivotHigh, pivotBar, lastPivotHigh, color=bullishChochColor, style=line.style_solid, width=2))
                    array.push(structureLabels, label.new((pivotBar + lastPivotHighBar) / 2, lastPivotHigh, "CHoCH", style=label.style_none, textcolor=bullishChochColor))
                // Create MST target for CHoCH bullish
                if mst_enabled and mst_show_choch_targets
                    mst_create_bull_target(mst_choch_bull_targets, lastPivotHighBar, lastPivotHigh, mst_choch_percentage, mst_choch_bull_color)

    // Update last pivot high
    lastPivotHigh := pivotPrice
    lastPivotHighBar := pivotBar

// When a new pivot LOW is confirmed
if not na(pl)
    int pivotBar = bar_index
    float pivotPrice = pl

    // Manage history
    if array.size(structureLines) >= structHistoryNbr * 2
        line.delete(array.get(structureLines, 0))
        label.delete(array.get(structureLabels, 0))
        array.remove(structureLines, 0)
        array.remove(structureLabels, 0)

    // Only detect if enough bars passed since last break (reduce noise)
    bool canDetectBreak = (bar_index - lastBreakBar) >= minBarsBetweenBreaks

    // Determine if this is CHoCH or BOS
    if not na(lastPivotLow) and canDetectBreak
        if pivotPrice < lastPivotLow
            // Price broke below previous low
            if structureDirection == 1
                // Already bearish → BOS (continuation)
                bos_bearish := true
                lastBreakBar := bar_index
                // Visual elements (optional)
                if showBOS
                    array.push(structureLines, line.new(lastPivotLowBar, lastPivotLow, pivotBar, lastPivotLow, color=bearishBosColor, style=line.style_solid, width=1))
                    array.push(structureLabels, label.new((pivotBar + lastPivotLowBar) / 2, lastPivotLow, "BOS", style=label.style_none, textcolor=bearishBosColor))
                // Create MST target for BOS bearish
                if mst_enabled and mst_show_bos_targets
                    mst_create_bear_target(mst_bos_bear_targets, lastPivotLowBar, lastPivotLow, mst_bos_percentage, mst_bos_bear_color)
            else if structureDirection != 1
                // Was bullish/neutral → CHoCH (reversal)
                choch_bearish := true
                structureDirection := 1
                lastBreakBar := bar_index
                // Visual elements (optional)
                if showCHoCH
                    array.push(structureLines, line.new(lastPivotLowBar, lastPivotLow, pivotBar, lastPivotLow, color=bearishChochColor, style=line.style_solid, width=2))
                    array.push(structureLabels, label.new((pivotBar + lastPivotLowBar) / 2, lastPivotLow, "CHoCH", style=label.style_none, textcolor=bearishChochColor))
                // Create MST target for CHoCH bearish
                if mst_enabled and mst_show_choch_targets
                    mst_create_bear_target(mst_choch_bear_targets, lastPivotLowBar, lastPivotLow, mst_choch_percentage, mst_choch_bear_color)

    // Update last pivot low
    lastPivotLow := pivotPrice
    lastPivotLowBar := pivotBar

// ============================================================================
// MST TARGET UPDATES (Run every bar)
// ============================================================================

if mst_enabled
    // Update all target arrays
    mst_update_targets(mst_choch_bull_targets, true)
    mst_update_targets(mst_choch_bear_targets, false)
    mst_update_targets(mst_bos_bull_targets, true)
    mst_update_targets(mst_bos_bear_targets, false)

// ============================================================================
// MST TP EXECUTION (Close positions when targets are hit)
// ============================================================================

if mst_enabled and mst_exit_mode == "BOS Counting"
    // BOS COUNTING MODE - Count BOS after entry and close at specific counts

    // LONG positions - count BOS bullish
    if strategy.position_size > 0
        // Increment counter when BOS bullish is detected
        if bos_bullish
            bos_count_long := bos_count_long + 1

            // TP1: First BOS after entry
            if bos_count_long == 1
                strategy.close("Long", qty_percent=mst_tp1_percentage, comment="BOS TP1")
                exit_by_mst_tp1_long := true

            // TP2: Second BOS after entry
            else if bos_count_long == 2
                strategy.close("Long", qty_percent=mst_tp2_percentage, comment="BOS TP2")
                exit_by_mst_tp2_long := true

    // SHORT positions - count BOS bearish
    if strategy.position_size < 0
        // Increment counter when BOS bearish is detected
        if bos_bearish
            bos_count_short := bos_count_short + 1

            // TP1: First BOS after entry
            if bos_count_short == 1
                strategy.close("Short", qty_percent=mst_tp1_percentage, comment="BOS TP1")
                exit_by_mst_tp1_short := true

            // TP2: Second BOS after entry
            else if bos_count_short == 2
                strategy.close("Short", qty_percent=mst_tp2_percentage, comment="BOS TP2")
                exit_by_mst_tp2_short := true

else if mst_enabled and mst_exit_mode != "Visual Only"
    // MST TARGET-BASED MODE - Close when price reaches projected targets

    // LONG positions - check for bullish targets hit
    if strategy.position_size > 0
        // Check CHoCH targets (TP1)
        if not mst_tp1_hit_long and array.size(mst_choch_bull_targets) > 0
            for tgt in mst_choch_bull_targets
                if tgt.active and high >= tgt.target_price
                    mst_tp1_hit_long := true
                    if mst_exit_mode == "Simple TP"
                        // Close 100% on first target
                        strategy.close("Long", comment="MST TP")
                        exit_by_mst_tp1_long := true
                    else if mst_exit_mode == "Multiple TP"
                        // Close 50% on CHoCH target
                        strategy.close("Long", qty_percent=50, comment="MST TP1")
                        exit_by_mst_tp1_long := true
                    break

        // Check BOS targets (TP2) - only in Multiple TP mode
        if not mst_tp2_hit_long and mst_exit_mode == "Multiple TP" and array.size(mst_bos_bull_targets) > 0
            for tgt in mst_bos_bull_targets
                if tgt.active and high >= tgt.target_price
                    mst_tp2_hit_long := true
                    // Close remaining 50% on BOS target
                    strategy.close("Long", comment="MST TP2")
                    exit_by_mst_tp2_long := true
                    break

    // SHORT positions - check for bearish targets hit
    if strategy.position_size < 0
        // Check CHoCH targets (TP1)
        if not mst_tp1_hit_short and array.size(mst_choch_bear_targets) > 0
            for tgt in mst_choch_bear_targets
                if tgt.active and low <= tgt.target_price
                    mst_tp1_hit_short := true
                    if mst_exit_mode == "Simple TP"
                        // Close 100% on first target
                        strategy.close("Short", comment="MST TP")
                        exit_by_mst_tp1_short := true
                    else if mst_exit_mode == "Multiple TP"
                        // Close 50% on CHoCH target
                        strategy.close("Short", qty_percent=50, comment="MST TP1")
                        exit_by_mst_tp1_short := true
                    break

        // Check BOS targets (TP2) - only in Multiple TP mode
        if not mst_tp2_hit_short and mst_exit_mode == "Multiple TP" and array.size(mst_bos_bear_targets) > 0
            for tgt in mst_bos_bear_targets
                if tgt.active and low <= tgt.target_price
                    mst_tp2_hit_short := true
                    // Close remaining 50% on BOS target
                    strategy.close("Short", comment="MST TP2")
                    exit_by_mst_tp2_short := true
                    break

// ============================================================================
// STRATEGY LOGIC
// ============================================================================

var bool waiting_long_confirmation = false
var bool waiting_short_confirmation = false

if choch_bullish
    waiting_long_confirmation := true
    waiting_short_confirmation := false
    hma_touched_long := false  // Reset HMA touch flag
    st_zone_touched_long := false  // Reset ST touch flag

if choch_bearish
    waiting_short_confirmation := true
    waiting_long_confirmation := false
    hma_touched_short := false  // Reset HMA touch flag
    st_zone_touched_short := false  // Reset ST touch flag

// ============================================================================
// HMA FILTER - Detect if price touches HMA while waiting for confirmation
// ============================================================================

// Detect HMA touch for LONG: price pulls back to HMA while in uptrend
if waiting_long_confirmation and use_hma_filter_long
    // Check if candle touched HMA (low reached it) while close is above (bullish)
    if low <= hma and close > hma
        hma_touched_long := true

// Detect HMA touch for SHORT: price retraces to HMA while in downtrend
if waiting_short_confirmation and use_hma_filter_short
    // Check if candle touched HMA (high reached it) while close is below (bearish)
    if high >= hma and close < hma
        hma_touched_short := true

var bool long_entry = false
var bool short_entry = false

long_entry := false
short_entry := false

// LONG entry: CHoCH + BOS + HMA filter (if enabled) + Smooth Trail (if enabled)
if waiting_long_confirmation and bos_bullish
    // Check HMA filter condition
    bool hma_condition_met = true
    if use_hma_filter_long
        hma_condition_met := hma_touched_long

    // Check Smooth Trail condition
    bool st_condition_met = true
    if st_enabled and st_use_as_confirmation
        st_condition_met := st_zone_touched_long

    // Entry requires all enabled conditions to be met
    if hma_condition_met and st_condition_met
        long_entry := true
        waiting_long_confirmation := false
        hma_touched_long := false
        st_zone_touched_long := false

// SHORT entry: CHoCH + BOS + HMA filter (if enabled) + Smooth Trail (if enabled)
if waiting_short_confirmation and bos_bearish
    // Check HMA filter condition
    bool hma_condition_met = true
    if use_hma_filter_short
        hma_condition_met := hma_touched_short

    // Check Smooth Trail condition
    bool st_condition_met = true
    if st_enabled and st_use_as_confirmation
        st_condition_met := st_zone_touched_short

    // Entry requires all enabled conditions to be met
    if hma_condition_met and st_condition_met
        short_entry := true
        waiting_short_confirmation := false
        hma_touched_short := false
        st_zone_touched_short := false

// Invalidate long setup if opposite CHoCH appears
if waiting_long_confirmation and choch_bearish
    waiting_long_confirmation := false
    hma_touched_long := false
    st_zone_touched_long := false

// Invalidate short setup if opposite CHoCH appears
if waiting_short_confirmation and choch_bullish
    waiting_short_confirmation := false
    hma_touched_short := false
    st_zone_touched_short := false

var bool long_exit = false
var bool short_exit = false
var string long_exit_reason = ""
var string short_exit_reason = ""

long_exit := false
short_exit := false
long_exit_reason := ""
short_exit_reason := ""

// === EXIT LOGIC ===
if strategy.position_size > 0
    // LONG position exit logic
    if exit_on_bos_opposite
        // Mode: CHoCH → Wait BOS confirmation
        if choch_bearish
            waiting_exit_long_confirmation := true

        if choch_bullish
            // Opposite CHoCH: cancel exit signal
            waiting_exit_long_confirmation := false

        if waiting_exit_long_confirmation and bos_bearish
            // Exit confirmed by BOS
            long_exit := true
            long_exit_reason := "CHoCH+BOS Bearish"
            waiting_exit_long_confirmation := false
    else
        // Mode: Exit immediately on CHoCH
        if choch_bearish
            long_exit := true
            long_exit_reason := "CHoCH Bearish"

if strategy.position_size < 0
    // SHORT position exit logic
    if exit_on_bos_opposite
        // Mode: CHoCH → Wait BOS confirmation
        if choch_bullish
            waiting_exit_short_confirmation := true

        if choch_bearish
            // Opposite CHoCH: cancel exit signal
            waiting_exit_short_confirmation := false

        if waiting_exit_short_confirmation and bos_bullish
            // Exit confirmed by BOS
            short_exit := true
            short_exit_reason := "CHoCH+BOS Bullish"
            waiting_exit_short_confirmation := false
    else
        // Mode: Exit immediately on CHoCH
        if choch_bullish
            short_exit := true
            short_exit_reason := "CHoCH Bullish"

// Execute trades (with enable filters)
if long_entry and enable_longs
    strategy.entry("Long", strategy.long)
    max_profit_long := 0.0  // Reset max profit tracker
    mst_tp1_hit_long := false  // Reset MST TP tracking
    mst_tp2_hit_long := false
    bos_count_long := 0  // Reset BOS counter

if short_entry and enable_shorts
    strategy.entry("Short", strategy.short)
    max_profit_short := 0.0  // Reset max profit tracker
    mst_tp1_hit_short := false  // Reset MST TP tracking
    mst_tp2_hit_short := false
    bos_count_short := 0  // Reset BOS counter

if long_exit
    strategy.close("Long", comment=long_exit_reason)

if short_exit
    strategy.close("Short", comment=short_exit_reason)

// Risk Management: Stop Loss + Trailing Stop + Break Even
// Calculate stops for active positions
if strategy.position_size > 0
    // LONG position
    float entry_price = strategy.position_avg_price
    float current_profit_pct = ((close - entry_price) / entry_price) * 100

    // Track maximum profit reached
    if current_profit_pct > max_profit_long
        max_profit_long := current_profit_pct

    // Calculate stop price
    float stop_price = na

    // BOS Counting: Move to BE after TP1
    if mst_exit_mode == "BOS Counting" and mst_move_to_be and bos_count_long >= 1
        // Move stop to breakeven + 0.1%
        stop_price := entry_price * 1.001
    else if use_trailing and max_profit_long >= trailing_offset
        // Trailing stop: keep stop at (max_profit - trailing_distance)%
        float trailing_stop_pct = max_profit_long - trailing_distance
        stop_price := entry_price * (1 + trailing_stop_pct / 100)
    else
        // Fixed stop loss
        stop_price := entry_price * (1 + stoploss_pct / 100)

    // Apply stop loss order
    strategy.exit("SL/Trail Long", "Long", stop=stop_price)

else if strategy.position_size < 0
    // SHORT position
    float entry_price = strategy.position_avg_price
    float current_profit_pct = ((entry_price - close) / entry_price) * 100

    // Track maximum profit reached
    if current_profit_pct > max_profit_short
        max_profit_short := current_profit_pct

    // Calculate stop price
    float stop_price = na

    // BOS Counting: Move to BE after TP1
    if mst_exit_mode == "BOS Counting" and mst_move_to_be and bos_count_short >= 1
        // Move stop to breakeven + 0.1%
        stop_price := entry_price * 0.999
    else if use_trailing and max_profit_short >= trailing_offset
        // Trailing stop: keep stop at (max_profit - trailing_distance)%
        float trailing_stop_pct = max_profit_short - trailing_distance
        stop_price := entry_price * (1 - trailing_stop_pct / 100)
    else
        // Fixed stop loss
        stop_price := entry_price * (1 - stoploss_pct / 100)

    // Apply stop loss order
    strategy.exit("SL/Trail Short", "Short", stop=stop_price)

// ============================================================================
// DETECT EXIT TYPE (for markers)
// ============================================================================

// Detect if a LONG position just closed
if prev_position_size > 0 and strategy.position_size == 0
    // Position closed - was it by CHoCH exit or SL/trailing?
    if not long_exit
        // Closed by SL or trailing (not by CHoCH)
        if use_trailing and max_profit_long >= trailing_offset
            // Was using trailing stop
            exit_by_trailing_long := true
        else
            // Was using fixed SL
            exit_by_stoploss_long := true

// Detect if a SHORT position just closed
if prev_position_size < 0 and strategy.position_size == 0
    // Position closed - was it by CHoCH exit or SL/trailing?
    if not short_exit
        // Closed by SL or trailing (not by CHoCH)
        if use_trailing and max_profit_short >= trailing_offset
            // Was using trailing stop
            exit_by_trailing_short := true
        else
            // Was using fixed SL
            exit_by_stoploss_short := true

// Update position tracking
prev_position_size := strategy.position_size

// ============================================================================
// VISUAL ELEMENTS
// ============================================================================

// Entry waiting states
bgcolor(showBackgroundStates and waiting_long_confirmation ? color.new(color.lime, 95) : na)
bgcolor(showBackgroundStates and waiting_short_confirmation ? color.new(color.orange, 95) : na)

// Exit waiting states (orange/red tint)
bgcolor(showBackgroundStates and waiting_exit_long_confirmation ? color.new(color.red, 92) : na)
bgcolor(showBackgroundStates and waiting_exit_short_confirmation ? color.new(color.orange, 92) : na)

// Entry signals
plotshape(showEntrySignals and long_entry, "Long Entry", shape.labelup, location.belowbar, color.new(color.lime, 0), size=size.small, text="LONG", textcolor=color.white)
plotshape(showEntrySignals and short_entry, "Short Entry", shape.labeldown, location.abovebar, color.new(color.red, 0), size=size.small, text="SHORT", textcolor=color.white)

// Exit signals - CHoCH/BOS exits
plotshape(showExitSignals and long_exit, "Long Exit CHoCH", shape.xcross, location.abovebar, color.new(color.yellow, 0), size=size.small, text="TP")
plotshape(showExitSignals and short_exit, "Short Exit CHoCH", shape.xcross, location.belowbar, color.new(color.yellow, 0), size=size.small, text="TP")

// Exit signals - Stop Loss
plotshape(showExitSignals and exit_by_stoploss_long, "Long SL", shape.circle, location.abovebar, color.new(color.red, 0), size=size.tiny, text="SL")
plotshape(showExitSignals and exit_by_stoploss_short, "Short SL", shape.circle, location.belowbar, color.new(color.red, 0), size=size.tiny, text="SL")

// Exit signals - Trailing Stop
plotshape(showExitSignals and exit_by_trailing_long, "Long Trail", shape.triangledown, location.abovebar, color.new(color.orange, 0), size=size.tiny, text="TRAIL")
plotshape(showExitSignals and exit_by_trailing_short, "Short Trail", shape.triangleup, location.belowbar, color.new(color.orange, 0), size=size.tiny, text="TRAIL")

// Exit signals - MST TP1
plotshape(showExitSignals and exit_by_mst_tp1_long, "Long MST TP1", shape.diamond, location.abovebar, color.new(#089981, 0), size=size.small, text="MST TP1")
plotshape(showExitSignals and exit_by_mst_tp1_short, "Short MST TP1", shape.diamond, location.belowbar, color.new(#f23645, 0), size=size.small, text="MST TP1")

// Exit signals - MST TP2
plotshape(showExitSignals and exit_by_mst_tp2_long, "Long MST TP2", shape.diamond, location.abovebar, color.new(#089981, 50), size=size.small, text="MST TP2")
plotshape(showExitSignals and exit_by_mst_tp2_short, "Short MST TP2", shape.diamond, location.belowbar, color.new(#f23645, 50), size=size.small, text="MST TP2")

// Information table
var table info_table = table.new(position.top_right, 2, 10, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

if barstate.islast
    table.cell(info_table, 0, 0, "Status", text_color=color.white, bgcolor=color.gray)
    string status_text = "NEUTRAL"
    color status_color = color.gray

    if strategy.position_size > 0
        if waiting_exit_long_confirmation
            status_text := "IN LONG (EXIT?)"
            status_color := color.orange
        else
            status_text := "IN LONG"
            status_color := color.green
    else if strategy.position_size < 0
        if waiting_exit_short_confirmation
            status_text := "IN SHORT (EXIT?)"
            status_color := color.orange
        else
            status_text := "IN SHORT"
            status_color := color.red
    else if waiting_long_confirmation
        status_text := "WAIT LONG BOS"
        status_color := color.lime
    else if waiting_short_confirmation
        status_text := "WAIT SHORT BOS"
        status_color := color.orange

    table.cell(info_table, 1, 0, status_text, text_color=color.white, bgcolor=status_color)

    table.cell(info_table, 0, 1, "Direction", text_color=color.white, bgcolor=color.gray)
    string dir_text = structureDirection == 2 ? "BULLISH" : structureDirection == 1 ? "BEARISH" : "NEUTRAL"
    color dir_color = structureDirection == 2 ? color.green : structureDirection == 1 ? color.red : color.gray
    table.cell(info_table, 1, 1, dir_text, text_color=color.white, bgcolor=dir_color)

    // Profit and Trailing info
    table.cell(info_table, 0, 2, "Current Profit", text_color=color.white, bgcolor=color.gray)
    string profit_text = "N/A"
    color profit_color = color.gray
    if strategy.position_size != 0
        float entry = strategy.position_avg_price
        float current_pnl_pct = strategy.position_size > 0 ? ((close - entry) / entry) * 100 : ((entry - close) / entry) * 100
        profit_text := str.tostring(current_pnl_pct, "#.##") + "%"
        profit_color := current_pnl_pct > 0 ? color.green : color.red
    table.cell(info_table, 1, 2, profit_text, text_color=color.white, bgcolor=profit_color)

    table.cell(info_table, 0, 3, "Trailing Stop", text_color=color.white, bgcolor=color.gray)
    string trailing_text = "INACTIVE"
    color trailing_color = color.gray
    if use_trailing
        if strategy.position_size > 0 and max_profit_long >= trailing_offset
            trailing_text := "ACTIVE (" + str.tostring(max_profit_long, "#.##") + "%)"
            trailing_color := color.orange
        else if strategy.position_size < 0 and max_profit_short >= trailing_offset
            trailing_text := "ACTIVE (" + str.tostring(max_profit_short, "#.##") + "%)"
            trailing_color := color.orange
        else if strategy.position_size != 0
            trailing_text := "WAITING"
            trailing_color := color.blue
    else
        trailing_text := "DISABLED"
    table.cell(info_table, 1, 3, trailing_text, text_color=color.white, bgcolor=trailing_color)

    table.cell(info_table, 0, 4, "Last Pivot High", text_color=color.white, bgcolor=color.gray)
    string highText = not na(lastPivotHigh) ? str.tostring(lastPivotHigh, "#.####") : "N/A"
    table.cell(info_table, 1, 4, highText, text_color=color.red, bgcolor=color.new(color.gray, 70))

    table.cell(info_table, 0, 5, "Last Pivot Low", text_color=color.white, bgcolor=color.gray)
    string lowText = not na(lastPivotLow) ? str.tostring(lastPivotLow, "#.####") : "N/A"
    table.cell(info_table, 1, 5, lowText, text_color=color.green, bgcolor=color.new(color.gray, 70))

    table.cell(info_table, 0, 6, "ZigZag Period", text_color=color.white, bgcolor=color.gray)
    table.cell(info_table, 1, 6, str.tostring(prd) + " bars", text_color=color.white, bgcolor=color.new(color.gray, 70))

    table.cell(info_table, 0, 7, "Min Bars Break", text_color=color.white, bgcolor=color.gray)
    table.cell(info_table, 1, 7, str.tostring(minBarsBetweenBreaks), text_color=color.white, bgcolor=color.new(color.gray, 70))

    // HMA Filter Status
    table.cell(info_table, 0, 8, "HMA Filter", text_color=color.white, bgcolor=color.gray)
    string hma_text = "OFF"
    color hma_color = color.gray

    if use_hma_filter_long or use_hma_filter_short
        if waiting_long_confirmation and use_hma_filter_long
            hma_text := hma_touched_long ? "LONG OK ✓" : "WAIT TOUCH"
            hma_color := hma_touched_long ? color.green : color.orange
        else if waiting_short_confirmation and use_hma_filter_short
            hma_text := hma_touched_short ? "SHORT OK ✓" : "WAIT TOUCH"
            hma_color := hma_touched_short ? color.green : color.orange
        else
            hma_text := "ON"
            hma_color := color.blue

    table.cell(info_table, 1, 8, hma_text, text_color=color.white, bgcolor=hma_color)

    // Smooth Trail Status
    table.cell(info_table, 0, 9, "Smooth Trail", text_color=color.white, bgcolor=color.gray)
    string st_text = "OFF"
    color st_color = color.gray

    if st_enabled
        if st_use_as_confirmation
            if waiting_long_confirmation
                st_text := st_zone_touched_long ? "LONG OK ✓" : "WAIT ZONE"
                st_color := st_zone_touched_long ? color.green : color.orange
            else if waiting_short_confirmation
                st_text := st_zone_touched_short ? "SHORT OK ✓" : "WAIT ZONE"
                st_color := st_zone_touched_short ? color.green : color.orange
            else
                st_text := st_bullish ? "BULLISH" : "BEARISH"
                st_color := st_bullish ? color.green : color.red
        else
            st_text := st_bullish ? "BULLISH" : "BEARISH"
            st_color := st_bullish ? color.green : color.red

    table.cell(info_table, 1, 9, st_text, text_color=color.white, bgcolor=st_color)

// Alerts
alertcondition(choch_bullish, "CHoCH Bullish", "CHoCH Bullish - prepare for long")
alertcondition(choch_bearish, "CHoCH Bearish", "CHoCH Bearish - prepare for short")
alertcondition(bos_bullish, "BOS Bullish", "BOS Bullish - trend continuation")
alertcondition(bos_bearish, "BOS Bearish", "BOS Bearish - trend continuation")
alertcondition(long_entry, "Long Entry", "ENTRY LONG: CHoCH + BOS confirmed")
alertcondition(short_entry, "Short Entry", "ENTRY SHORT: CHoCH + BOS confirmed")
alertcondition(long_exit, "Long Exit", "EXIT LONG: CHoCH Bearish")
alertcondition(short_exit, "Short Exit", "EXIT SHORT: CHoCH Bullish")
