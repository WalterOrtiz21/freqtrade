//@version=6
strategy("CHoCH/BOS Simple - With ROI Table",
         overlay=true,
         initial_capital=1000,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=10,
         commission_type=strategy.commission.percent,
         commission_value=0.05,
         slippage=1,
         pyramiding=0,
         calc_on_every_tick=false)

// ═══════════════════════════════════════════════════════════
// PARAMETERS
// ═══════════════════════════════════════════════════════════

// Structure Detection
zigzag_len = input.int(23, "ZigZag Length", minval=5, maxval=50, group="Structure")

// Entry Filters
require_fvg = input.bool(true, "Require FVG", group="Filters", tooltip="86.8% WR with this ON")

// Risk Management
stop_loss_pct = input.float(13.0, "Stop Loss %", minval=5, maxval=25, group="Risk")
use_trailing = input.bool(true, "Use Trailing Stop", group="Risk")
trail_trigger = input.float(5.5, "Trail Trigger %", minval=2, maxval=15, group="Risk")
trail_offset = input.float(2.0, "Trail Offset %", minval=1, maxval=10, group="Risk")

// ROI Table (matching Python)
roi_0 = input.float(10.0, "ROI 0min (10%)", group="ROI Table", tooltip="Target profit at any time")
roi_60 = input.float(5.0, "ROI 60min (5%)", group="ROI Table", tooltip="After 1 hour")
roi_120 = input.float(3.0, "ROI 120min (3%)", group="ROI Table", tooltip="After 2 hours")
roi_240 = input.float(1.0, "ROI 240min (1%)", group="ROI Table", tooltip="After 4 hours")

// Visuals
show_structure = input.bool(true, "Show Structure", group="Visual")
show_fvg = input.bool(true, "Show FVG", group="Visual")
show_pivots = input.bool(true, "Show Pivots", group="Visual")

// ═══════════════════════════════════════════════════════════
// PIVOT DETECTION
// ═══════════════════════════════════════════════════════════

pivot_high = ta.pivothigh(high, zigzag_len, zigzag_len)
pivot_low = ta.pivotlow(low, zigzag_len, zigzag_len)

var float last_pivot_high = na
var float last_pivot_low = na

if not na(pivot_high)
    last_pivot_high := pivot_high
if not na(pivot_low)
    last_pivot_low := pivot_low

// ═══════════════════════════════════════════════════════════
// MARKET STRUCTURE (CHoCH & BOS)
// ═══════════════════════════════════════════════════════════

var int trend = 0
var bool choch_bull = false
var bool choch_bear = false
var bool bos_bull = false
var bool bos_bear = false

choch_bull := false
choch_bear := false
bos_bull := false
bos_bear := false

if not na(last_pivot_high) and not na(last_pivot_low)
    if trend == 0
        if close > last_pivot_high
            bos_bull := true
            trend := 2
        else if close < last_pivot_low
            bos_bear := true
            trend := 1
    else if trend == 1
        if close < last_pivot_low
            bos_bear := true
        else if close > last_pivot_high
            choch_bull := true
            trend := 2
    else if trend == 2
        if close > last_pivot_high
            bos_bull := true
        else if close < last_pivot_low
            choch_bear := true
            trend := 1

var int choch_bull_bar = 0
var int choch_bear_bar = 0

if choch_bull
    choch_bull_bar := bar_index
if choch_bear
    choch_bear_bar := bar_index

choch_bull_recent = (bar_index - choch_bull_bar) <= 20
choch_bear_recent = (bar_index - choch_bear_bar) <= 20

// ═══════════════════════════════════════════════════════════
// FVG DETECTION
// ═══════════════════════════════════════════════════════════

bull_fvg = low > high[2]
bear_fvg = high < low[2]

in_bull_fvg = false
in_bear_fvg = false

for i = 1 to 20
    if low[i] > high[i+2]
        fvg_top = low[i]
        fvg_bot = high[i+2]
        if low <= fvg_top and high >= fvg_bot
            in_bull_fvg := true
            break

for i = 1 to 20
    if high[i] < low[i+2]
        fvg_top = low[i+2]
        fvg_bot = high[i]
        if high >= fvg_bot and low <= fvg_top
            in_bear_fvg := true
            break

// ═══════════════════════════════════════════════════════════
// ENTRY CONDITIONS
// ═══════════════════════════════════════════════════════════

long_base = bos_bull and choch_bull_recent
long_condition = require_fvg ? (long_base and in_bull_fvg) : long_base

short_base = bos_bear and choch_bear_recent
short_condition = require_fvg ? (short_base and in_bear_fvg) : short_base

// ═══════════════════════════════════════════════════════════
// TIME-BASED ROI EXIT SYSTEM
// ═══════════════════════════════════════════════════════════

// Track entry time and price
var float entry_price = na
var int entry_bar = na
var bool in_long = false
var bool in_short = false

// Entry
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long, comment="CHoCH→BOS" + (require_fvg ? "+FVG" : ""))
    entry_price := close
    entry_bar := bar_index
    in_long := true
    in_short := false

if short_condition and strategy.position_size == 0
    strategy.entry("Short", strategy.short, comment="CHoCH→BOS" + (require_fvg ? "+FVG" : ""))
    entry_price := close
    entry_bar := bar_index
    in_short := true
    in_long := false

// Calculate time in position (in 15m bars)
bars_in_position = strategy.position_size != 0 ? (bar_index - entry_bar) : 0
minutes_in_position = bars_in_position * 15

// Dynamic ROI target based on time
var float current_roi_target = 10.0

if strategy.position_size != 0
    if minutes_in_position >= 240
        current_roi_target := roi_240  // 1% after 4 hours
    else if minutes_in_position >= 120
        current_roi_target := roi_120  // 3% after 2 hours
    else if minutes_in_position >= 60
        current_roi_target := roi_60   // 5% after 1 hour
    else
        current_roi_target := roi_0    // 10% anytime

// Exit on ROI - Long
if strategy.position_size > 0
    profit_pct = ((close - strategy.position_avg_price) / strategy.position_avg_price) * 100

    if profit_pct >= current_roi_target
        strategy.close("Long", comment="ROI " + str.tostring(current_roi_target, "#.#") + "%")
        in_long := false

// Exit on ROI - Short
if strategy.position_size < 0
    profit_pct = ((strategy.position_avg_price - close) / strategy.position_avg_price) * 100

    if profit_pct >= current_roi_target
        strategy.close("Short", comment="ROI " + str.tostring(current_roi_target, "#.#") + "%")
        in_short := false

// Exit on Stop Loss - Long
if strategy.position_size > 0
    stop_price = strategy.position_avg_price * (1 - stop_loss_pct/100)

    if use_trailing and close >= strategy.position_avg_price * (1 + trail_trigger/100)
        strategy.exit("Trail Long", "Long",
                     stop=stop_price,
                     trail_offset=trail_offset/100)
    else
        strategy.exit("SL Long", "Long", stop=stop_price)

// Exit on Stop Loss - Short
if strategy.position_size < 0
    stop_price = strategy.position_avg_price * (1 + stop_loss_pct/100)

    if use_trailing and close <= strategy.position_avg_price * (1 - trail_trigger/100)
        strategy.exit("Trail Short", "Short",
                     stop=stop_price,
                     trail_offset=trail_offset/100)
    else
        strategy.exit("SL Short", "Short", stop=stop_price)

// Reset tracking when no position
if strategy.position_size == 0
    in_long := false
    in_short := false

// ═══════════════════════════════════════════════════════════
// VISUALS
// ═══════════════════════════════════════════════════════════

plotshape(show_pivots and not na(pivot_high), "Pivot H", shape.triangledown,
         location.abovebar, color.new(color.red, 30), size=size.tiny)
plotshape(show_pivots and not na(pivot_low), "Pivot L", shape.triangleup,
         location.belowbar, color.new(color.lime, 30), size=size.tiny)

plotshape(show_structure and choch_bull, "CHoCH↑", shape.labelup,
         location.belowbar, color.lime, text="CHoCH",
         textcolor=color.white, size=size.normal)
plotshape(show_structure and choch_bear, "CHoCH↓", shape.labeldown,
         location.abovebar, color.red, text="CHoCH",
         textcolor=color.white, size=size.normal)

plotshape(show_structure and bos_bull, "BOS↑", shape.circle,
         location.belowbar, color.new(color.lime, 50), size=size.tiny)
plotshape(show_structure and bos_bear, "BOS↓", shape.circle,
         location.abovebar, color.new(color.red, 50), size=size.tiny)

if show_fvg and bull_fvg
    box.new(bar_index, low, bar_index + 20, high[2],
           border_color=color.new(color.lime, 70),
           bgcolor=color.new(color.lime, 90))

if show_fvg and bear_fvg
    box.new(bar_index, low[2], bar_index + 20, high,
           border_color=color.new(color.red, 70),
           bgcolor=color.new(color.red, 90))

plot(show_structure ? last_pivot_high : na, "Last High",
     color.new(color.red, 50), 1, plot.style_stepline)
plot(show_structure ? last_pivot_low : na, "Last Low",
     color.new(color.lime, 50), 1, plot.style_stepline)

bgcolor(long_condition ? color.new(color.lime, 90) : na)
bgcolor(short_condition ? color.new(color.red, 90) : na)

// ═══════════════════════════════════════════════════════════
// INFO TABLE
// ═══════════════════════════════════════════════════════════

var table info = table.new(position.top_right, 2, 7, border_width=1)

if barstate.islast
    table.cell(info, 0, 0, "Metric", bgcolor=color.new(color.blue, 0), text_color=color.white)
    table.cell(info, 1, 0, "Value", bgcolor=color.new(color.blue, 0), text_color=color.white)

    table.cell(info, 0, 1, "Trend", text_halign=text.align_left)
    trend_text = trend == 2 ? "BULLISH" : trend == 1 ? "BEARISH" : "NEUTRAL"
    trend_color = trend == 2 ? color.lime : trend == 1 ? color.red : color.gray
    table.cell(info, 1, 1, trend_text, text_halign=text.align_right, text_color=trend_color)

    table.cell(info, 0, 2, "FVG Filter", text_halign=text.align_left)
    table.cell(info, 1, 2, require_fvg ? "ON" : "OFF",
              text_halign=text.align_right,
              text_color=require_fvg ? color.lime : color.orange)

    table.cell(info, 0, 3, "ROI Target", text_halign=text.align_left)
    table.cell(info, 1, 3, str.tostring(current_roi_target, "#.#") + "%",
              text_halign=text.align_right,
              text_color=color.aqua)

    table.cell(info, 0, 4, "Time in Trade", text_halign=text.align_left)
    table.cell(info, 1, 4, str.tostring(minutes_in_position) + "m",
              text_halign=text.align_right)

    table.cell(info, 0, 5, "Stop Loss", text_halign=text.align_left)
    table.cell(info, 1, 5, str.tostring(stop_loss_pct) + "%", text_halign=text.align_right)

    table.cell(info, 0, 6, "Target WR", text_halign=text.align_left)
    table.cell(info, 1, 6, "86.8%", text_halign=text.align_right, text_color=color.lime)
