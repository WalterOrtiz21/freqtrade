//@version=6
strategy("CHoCH/BOS Simple - Optimized (86.8% WR)",
         overlay=true,
         initial_capital=1000,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=10,  // 10% of equity = 100 USDT at 1000 balance with 10x leverage
         commission_type=strategy.commission.percent,
         commission_value=0.05,
         slippage=1,
         margin_long=10,  // 10x leverage
         margin_short=10)

// ═══════════════════════════════════════════════════════════
// OPTIMIZED PARAMETERS (from 3792 trades, 86.8% WR backtest)
// ═══════════════════════════════════════════════════════════

// Structure Detection
zigzag_depth = input.int(23, "ZigZag Depth", minval=10, maxval=50, group="Structure")

// Entry Validations (FVG required for 86.8% WR)
require_fvg = input.bool(true, "Require FVG Retest", group="Entry Filters", tooltip="CRITICAL: Gives 86.8% WR")
require_ob = input.bool(false, "Require Order Block", group="Entry Filters")
fvg_lookback = input.int(20, "FVG Retest Lookback", minval=10, maxval=50, group="Entry Filters")

// Risk Management (Optimized from hyperopt)
stop_loss_pct = input.float(13.0, "Stop Loss %", minval=5, maxval=20, step=0.1, group="Risk Management")
trailing_stop_trigger = input.float(5.5, "Trailing Stop Trigger %", minval=2, maxval=10, step=0.1, group="Risk Management")
trailing_stop_offset = input.float(2.0, "Trailing Stop Offset %", minval=1, maxval=5, step=0.1, group="Risk Management")

// ROI Table (matches Python)
roi_0 = input.float(10.0, "ROI @ 0 min", minval=5, maxval=20, step=0.5, group="Take Profit")
roi_60 = input.float(5.0, "ROI @ 60 min", minval=2, maxval=10, step=0.5, group="Take Profit")
roi_120 = input.float(3.0, "ROI @ 120 min", minval=1, maxval=5, step=0.5, group="Take Profit")
roi_240 = input.float(1.0, "ROI @ 240 min", minval=0.5, maxval=3, step=0.5, group="Take Profit")

// Visual Settings
show_pivots = input.bool(true, "Show Pivots", group="Visual")
show_structure = input.bool(true, "Show CHoCH/BOS", group="Visual")
show_fvg = input.bool(true, "Show FVG Zones", group="Visual")
show_ob = input.bool(false, "Show Order Blocks", group="Visual")

// ═══════════════════════════════════════════════════════════
// PIVOT/ZIGZAG DETECTION
// ═══════════════════════════════════════════════════════════

f_is_pivot_high(len) =>
    is_pivot = true
    for i = 1 to len
        if high[i] >= high or high[len + i] >= high
            is_pivot := false
            break
    is_pivot

f_is_pivot_low(len) =>
    is_pivot = true
    for i = 1 to len
        if low[i] <= low or low[len + i] <= low
            is_pivot := false
            break
    is_pivot

// Detect pivots
pivot_high = f_is_pivot_high(zigzag_depth) ? high : na
pivot_low = f_is_pivot_low(zigzag_depth) ? low : na

// Track last significant pivots
var float last_high = na
var float last_low = na

if not na(pivot_high)
    last_high := pivot_high
if not na(pivot_low)
    last_low := pivot_low

// ═══════════════════════════════════════════════════════════
// CHoCH & BOS DETECTION
// ═══════════════════════════════════════════════════════════

var int structure = 0  // 0=neutral, 1=bearish, 2=bullish

var bool choch_bullish = false
var bool choch_bearish = false
var bool bos_bullish = false
var bool bos_bearish = false

choch_bullish := false
choch_bearish := false
bos_bullish := false
bos_bearish := false

if not na(last_high) and not na(last_low)
    if structure == 0  // NEUTRAL
        if close > last_high
            bos_bullish := true
            structure := 2
        else if close < last_low
            bos_bearish := true
            structure := 1

    else if structure == 1  // BEARISH TREND
        if close < last_low
            bos_bearish := true
            // structure remains bearish
        else if close > last_high
            choch_bullish := true
            structure := 2

    else if structure == 2  // BULLISH TREND
        if close > last_high
            bos_bullish := true
            // structure remains bullish
        else if close < last_low
            choch_bearish := true
            structure := 1

// Track recent CHoCH (last 20 bars)
var int choch_bull_bar = -100
var int choch_bear_bar = -100

if choch_bullish
    choch_bull_bar := bar_index
if choch_bearish
    choch_bear_bar := bar_index

choch_bull_recent = bar_index - choch_bull_bar <= 20
choch_bear_recent = bar_index - choch_bear_bar <= 20

// ═══════════════════════════════════════════════════════════
// FVG (FAIR VALUE GAP) DETECTION
// ═══════════════════════════════════════════════════════════

// Bullish FVG: low[0] > high[2]
fvg_bull = low > high[2]
fvg_bull_top = fvg_bull ? low : na
fvg_bull_bottom = fvg_bull ? high[2] : na

// Bearish FVG: high[0] < low[2]
fvg_bear = high < low[2]
fvg_bear_top = fvg_bear ? low[2] : na
fvg_bear_bottom = fvg_bear ? high : na

// Check if FVG has been retested in next fvg_lookback bars
var float[] fvg_bull_tops = array.new_float(0)
var float[] fvg_bull_bottoms = array.new_float(0)
var int[] fvg_bull_bars = array.new_int(0)

var float[] fvg_bear_tops = array.new_float(0)
var float[] fvg_bear_bottoms = array.new_float(0)
var int[] fvg_bear_bars = array.new_int(0)

// Store bullish FVG
if fvg_bull
    array.push(fvg_bull_tops, low)
    array.push(fvg_bull_bottoms, high[2])
    array.push(fvg_bull_bars, bar_index)

// Store bearish FVG
if fvg_bear
    array.push(fvg_bear_tops, low[2])
    array.push(fvg_bear_bottoms, high)
    array.push(fvg_bear_bars, bar_index)

// Check for FVG retest
fvg_bull_filled = false
fvg_bear_filled = false

// Check bullish FVG retest
if array.size(fvg_bull_tops) > 0
    for i = array.size(fvg_bull_tops) - 1 to 0
        if bar_index - array.get(fvg_bull_bars, i) <= fvg_lookback
            top = array.get(fvg_bull_tops, i)
            bottom = array.get(fvg_bull_bottoms, i)
            if low <= top and high >= bottom
                fvg_bull_filled := true
                break

// Check bearish FVG retest
if array.size(fvg_bear_tops) > 0
    for i = array.size(fvg_bear_tops) - 1 to 0
        if bar_index - array.get(fvg_bear_bars, i) <= fvg_lookback
            top = array.get(fvg_bear_tops, i)
            bottom = array.get(fvg_bear_bottoms, i)
            if high >= bottom and low <= top
                fvg_bear_filled := true
                break

// ═══════════════════════════════════════════════════════════
// ORDER BLOCK DETECTION (Optional)
// ═══════════════════════════════════════════════════════════

var float ob_bull_high = na
var float ob_bull_low = na
var int ob_bull_bar = -100

var float ob_bear_high = na
var float ob_bear_low = na
var int ob_bear_bar = -100

// Find last opposite candle before CHoCH
if choch_bullish
    for i = 1 to 20
        if close[i] < open[i]  // Bearish candle
            ob_bull_high := high[i]
            ob_bull_low := low[i]
            ob_bull_bar := bar_index - i
            break

if choch_bearish
    for i = 1 to 20
        if close[i] > open[i]  // Bullish candle
            ob_bear_high := high[i]
            ob_bear_low := low[i]
            ob_bear_bar := bar_index - i
            break

// Check OB retest
ob_bull_retest = not na(ob_bull_high) and bar_index - ob_bull_bar <= 20 and low <= ob_bull_high and high >= ob_bull_low
ob_bear_retest = not na(ob_bear_high) and bar_index - ob_bear_bar <= 20 and high >= ob_bear_low and low <= ob_bear_high

// ═══════════════════════════════════════════════════════════
// ENTRY CONDITIONS (Exact match to Python)
// ═══════════════════════════════════════════════════════════

// LONG: CHoCH bullish (recent) + BOS bullish + FVG retest (required)
long_base = bos_bullish and choch_bull_recent and volume > 0
long_condition = long_base
if require_fvg
    long_condition := long_condition and fvg_bull_filled
if require_ob
    long_condition := long_condition and ob_bull_retest

// SHORT: CHoCH bearish (recent) + BOS bearish + FVG retest (required)
short_base = bos_bearish and choch_bear_recent and volume > 0
short_condition = short_base
if require_fvg
    short_condition := short_condition and fvg_bear_filled
if require_ob
    short_condition := short_condition and ob_bear_retest

// ═══════════════════════════════════════════════════════════
// STRATEGY EXECUTION
// ═══════════════════════════════════════════════════════════

// Entry
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long, comment="CHoCH+BOS+FVG")

if short_condition and strategy.position_size == 0
    strategy.entry("Short", strategy.short, comment="CHoCH+BOS+FVG")

// Exit Management
if strategy.position_size > 0  // Long position
    // Calculate trailing stop and stop loss
    stop_price = strategy.position_avg_price * (1 - stop_loss_pct/100)

    // Trailing Stop (activates when price reaches trigger)
    if close >= strategy.position_avg_price * (1 + trailing_stop_trigger/100)
        trail_offset_pct = trailing_stop_offset / 100
        strategy.exit("Trail Long", "Long", trail_offset=trail_offset_pct, stop=stop_price)
    else
        // Regular stop loss before trailing activates
        strategy.exit("SL Long", "Long", stop=stop_price)

    // ROI exits (time-based)
    mins_in_trade = (time - strategy.opentrades.entry_time(0)) / 60000
    if mins_in_trade >= 240 and close >= strategy.position_avg_price * (1 + roi_240/100)
        strategy.close("Long", comment="ROI 240m")
    else if mins_in_trade >= 120 and close >= strategy.position_avg_price * (1 + roi_120/100)
        strategy.close("Long", comment="ROI 120m")
    else if mins_in_trade >= 60 and close >= strategy.position_avg_price * (1 + roi_60/100)
        strategy.close("Long", comment="ROI 60m")
    else if close >= strategy.position_avg_price * (1 + roi_0/100)
        strategy.close("Long", comment="ROI 0m")

if strategy.position_size < 0  // Short position
    // Calculate trailing stop and stop loss
    stop_price = strategy.position_avg_price * (1 + stop_loss_pct/100)

    // Trailing Stop (activates when price reaches trigger)
    if close <= strategy.position_avg_price * (1 - trailing_stop_trigger/100)
        trail_offset_pct = trailing_stop_offset / 100
        strategy.exit("Trail Short", "Short", trail_offset=trail_offset_pct, stop=stop_price)
    else
        // Regular stop loss before trailing activates
        strategy.exit("SL Short", "Short", stop=stop_price)

    // ROI exits
    mins_in_trade = (time - strategy.opentrades.entry_time(0)) / 60000
    if mins_in_trade >= 240 and close <= strategy.position_avg_price * (1 - roi_240/100)
        strategy.close("Short", comment="ROI 240m")
    else if mins_in_trade >= 120 and close <= strategy.position_avg_price * (1 - roi_120/100)
        strategy.close("Short", comment="ROI 120m")
    else if mins_in_trade >= 60 and close <= strategy.position_avg_price * (1 - roi_60/100)
        strategy.close("Short", comment="ROI 60m")
    else if close <= strategy.position_avg_price * (1 - roi_0/100)
        strategy.close("Short", comment="ROI 0m")

// ═══════════════════════════════════════════════════════════
// VISUAL INDICATORS
// ═══════════════════════════════════════════════════════════

// Plot pivots
plotshape(show_pivots and not na(pivot_high), "Pivot High", shape.triangledown, location.abovebar, color.rgb(255, 82, 82, 30), size=size.tiny)
plotshape(show_pivots and not na(pivot_low), "Pivot Low", shape.triangleup, location.belowbar, color.rgb(0, 230, 118, 30), size=size.tiny)

// Plot CHoCH and BOS
plotshape(show_structure and choch_bullish, "CHoCH ↑", shape.labelup, location.belowbar, color.rgb(0, 230, 118), text="CHoCH", textcolor=color.white, size=size.small)
plotshape(show_structure and choch_bearish, "CHoCH ↓", shape.labeldown, location.abovebar, color.rgb(255, 82, 82), text="CHoCH", textcolor=color.white, size=size.small)
plotshape(show_structure and bos_bullish, "BOS ↑", shape.circle, location.belowbar, color.rgb(0, 230, 118, 50), size=size.tiny)
plotshape(show_structure and bos_bearish, "BOS ↓", shape.circle, location.abovebar, color.rgb(255, 82, 82, 50), size=size.tiny)

// Plot FVG zones
var box fvg_bull_box = na
var box fvg_bear_box = na

if show_fvg and fvg_bull
    fvg_bull_box := box.new(bar_index, low, bar_index + fvg_lookback, high[2],
                             border_color=color.rgb(0, 230, 118, 70),
                             bgcolor=color.rgb(0, 230, 118, 90),
                             border_width=1)

if show_fvg and fvg_bear
    fvg_bear_box := box.new(bar_index, high, bar_index + fvg_lookback, low[2],
                             border_color=color.rgb(255, 82, 82, 70),
                             bgcolor=color.rgb(255, 82, 82, 90),
                             border_width=1)

// Plot last significant levels
plot(show_structure ? last_high : na, "Last High", color.rgb(255, 82, 82, 50), linewidth=1, style=plot.style_stepline)
plot(show_structure ? last_low : na, "Last Low", color.rgb(0, 230, 118, 50), linewidth=1, style=plot.style_stepline)

// ═══════════════════════════════════════════════════════════
// PERFORMANCE TABLE
// ═══════════════════════════════════════════════════════════

var table perf_table = table.new(position.bottom_right, 2, 7, border_width=1)

if barstate.islast
    table.cell(perf_table, 0, 0, "Metric", bgcolor=color.rgb(33, 150, 243), text_color=color.white)
    table.cell(perf_table, 1, 0, "Value", bgcolor=color.rgb(33, 150, 243), text_color=color.white)

    table.cell(perf_table, 0, 1, "Strategy", text_halign=text.align_left)
    table.cell(perf_table, 1, 1, "CHoCHBOSSimple", text_halign=text.align_right)

    table.cell(perf_table, 0, 2, "Backtested Pairs", text_halign=text.align_left)
    table.cell(perf_table, 1, 2, "17 pairs", text_halign=text.align_right)

    table.cell(perf_table, 0, 3, "Backtest WR", text_halign=text.align_left)
    table.cell(perf_table, 1, 3, "86.8%", text_halign=text.align_right, text_color=color.lime)

    table.cell(perf_table, 0, 4, "Total Trades", text_halign=text.align_left)
    table.cell(perf_table, 1, 4, "3792", text_halign=text.align_right)

    table.cell(perf_table, 0, 5, "Leverage", text_halign=text.align_left)
    table.cell(perf_table, 1, 5, "10x", text_halign=text.align_right, text_color=color.orange)

    table.cell(perf_table, 0, 6, "FVG Required", text_halign=text.align_left)
    table.cell(perf_table, 1, 6, require_fvg ? "YES ✓" : "NO", text_halign=text.align_right,
               text_color=require_fvg ? color.lime : color.red)
