// Converted to Strategy by User Request

//@version=5
strategy("Multi Kernel Regression Strategy [ChartPrime]", overlay = true, max_lines_count = 500, max_bars_back = 1000, max_labels_count = 500, initial_capital = 1000, default_qty_type = strategy.percent_of_equity, default_qty_value = 10)

// ==========================================
// ─── CONFIGURACIÓN DE ESTRATEGIA ───
// ==========================================
grp_strat = "Configuración de Estrategia"
use_longs = input.bool(true, "Operar Longs", group=grp_strat)
use_shorts = input.bool(true, "Operar Shorts", group=grp_strat)
// Filtro de Fechas
startYear = input.int(2023, "Año Inicio", group=grp_strat)
startMonth = input.int(1, "Mes Inicio", group=grp_strat)
startDay = input.int(1, "Día Inicio", group=grp_strat)
endYear = input.int(2999, "Año Fin", group=grp_strat)
endMonth = input.int(1, "Mes Fin", group=grp_strat)
endDay = input.int(1, "Día Fin", group=grp_strat)

in_date_range = time >= timestamp(syminfo.timezone, startYear, startMonth, startDay, 0, 0) and time < timestamp(syminfo.timezone, endYear, endMonth, endDay, 0, 0)

// ==========================================
// ─── INPUTS DEL INDICADOR ORIGINAL ───
// ==========================================
// Nota: Para la estrategia, se fuerza el cálculo interno NRP para las señales, 
// aunque visualmente permitimos el repintado si el usuario lo desea ver.
repaint_visual = input.bool(false, "Show Repainting Lines (Visual Only)", tooltip="Si activas esto, verás las líneas repintadas, pero la estrategia seguirá operando con la línea NO repintada para ser realista.")

kernel_type = input.string("Gaussian", "Kernel Select", 
 [ "Triangular"
 , "Gaussian"
 , "Epanechnikov"
 , "Logistic"
 , "Log Logistic"
 , "Cosine"
 , "Sinc"
 , "Laplace"
 , "Quartic"
 , "Parabolic"
 , "Exponential"
 , "Silverman"
 , "Cauchy"
 , "Tent"
 , "Wave"
 , "Power"
 , "Morters"])

bandwidth = input.int(14, 'Bandwidth', 1)
source = input.source(close, 'Source')
deviations = input.float(2.0, 'Deviation', 0, 100, 0.25, inline = "dev")
style = input.string("Solid", "Line Style", ["Solid", "Dotted", "Dashed"])
enable_band = input.bool(false, "Show Bands", inline = "dev")
label_size = input.string("Tiny", "Labels", ["Auto", "Tiny", "Small", "Normal", "Large", "Huge"], inline = "label")
show_labels = input.bool(true, "Show Labels", inline = "label")
bullish_color = input.color(color.rgb(84, 194, 148), "Colors", inline = "color")
bearish_color = input.color(color.rgb(235, 57, 57), "", inline = "color")
text_color = input.color(color.rgb(8, 12, 20), "", inline = "color")

size = switch label_size
    "Auto"   => size.auto
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    "Large"  => size.large
    "Huge"   => size.huge

line_style = switch style 
    "Solid"  => line.style_solid
    "Dotted" => line.style_dotted
    "Dashed" => line.style_dashed

sq(source) => math.pow(source, 2)

// Funciones Matemáticas del Kernel
gaussian(source, bandwidth) => 
    math.exp(-sq(source / bandwidth) / 2) / math.sqrt(2 * math.pi) 

triangular(source, bandwidth) =>
    math.abs(source/bandwidth) <= 1 ? 1 - math.abs(source/bandwidth) : 0.0

epanechnikov(source, bandwidth) =>
    math.abs(source/bandwidth) <= 1 ? (3/4.) * (1 - sq(source/bandwidth)) : 0.0

quartic(source, bandwidth) =>
    if math.abs(source/bandwidth) <= 1 
        15/16. * math.pow(1 - sq(source/bandwidth), 2)
    else
        0.0

logistic(source, bandwidth) =>
    1 / (math.exp(source / bandwidth) + 2 + math.exp(-source / bandwidth))

cosine(source, bandwidth) =>
    math.abs(source/bandwidth) <= 1 ? (math.pi / 4) * math.cos((math.pi / 2) * (source/bandwidth)) : 0.0

laplace(source, bandwidth) =>
    (1 / (2 * bandwidth)) * math.exp(-math.abs(source/bandwidth))

exponential(source, bandwidth) =>
    (1 / bandwidth) * math.exp(-math.abs(source/bandwidth))

silverman(source, bandwidth) =>
    if math.abs(source/bandwidth) <= 0.5 
        0.5 * math.exp(-(source/bandwidth)/2) * math.sin((source/bandwidth)/2 + math.pi/4) 
    else 
        0.0 

tent(source, bandwidth) =>
    if math.abs(source/bandwidth) <= 1
        1 - math.abs(source/bandwidth)
    else
        0.0

cauchy(source, bandwidth) =>
    1 / (math.pi * bandwidth * (1 + sq(source / bandwidth)))

sinc(source, bandwidth) =>
    if source == 0
        1
    else
        math.sin(math.pi * source / bandwidth) / (math.pi * source / bandwidth)

wave(source, bandwidth) =>
    if (math.abs(source/bandwidth) <= 1)
        (1 - math.abs(source/bandwidth)) * math.cos((math.pi * source) / bandwidth)
    else
        0.0

parabolic(source, bandwidth) =>
    if math.abs(source/bandwidth) <= 1
        1 - math.pow((source/bandwidth), 2)
    else
        0.0

power(source, bandwidth) =>
    if (math.abs(source/bandwidth) <= 1)
        math.pow(1 - math.pow(math.abs(source/bandwidth), 3), 3)
    else
        0.0

loglogistic(source, bandwidth) =>
    1 / math.pow(1 + math.abs(source / bandwidth), 2)

morters(source, bandwidth) =>
    if math.abs(source / bandwidth) <= math.pi
        (1 + math.cos(source / bandwidth)) / (2 * math.pi * bandwidth)
    else
        0.0

get_weight(source, bandwidth, style)=>
    switch style
        "Triangular"    => triangular(source, bandwidth)
        "Gaussian"      => gaussian(source, bandwidth)
        "Epanechnikov"  => epanechnikov(source, bandwidth)
        "Logistic"      => logistic(source, bandwidth)
        "Log Logistic"  => loglogistic(source, bandwidth)
        "Cosine"        => cosine(source, bandwidth)
        "Sinc"          => sinc(source, bandwidth)
        "Laplace"       => laplace(source, bandwidth)
        "Quartic"       => quartic(source, bandwidth)
        "Parabolic"     => parabolic(source, bandwidth)
        "Exponential"   => exponential(source, bandwidth)
        "Silverman"     => silverman(source, bandwidth)
        "Cauchy"        => cauchy(source, bandwidth)
        "Tent"          => tent(source, bandwidth)
        "Wave"          => wave(source, bandwidth)
        "Power"         => power(source, bandwidth)
        "Morters"       => morters(source, bandwidth)

type coefficients
    float[] weights
    float sumw

precalculate(float bandwidth, string kernel_name)=>
    var coefficients[] c = array.new<coefficients>()
    if barstate.isfirst
        for i = 0 to 499
            coefficients w = coefficients.new(array.new<float>(), 0)
            float sumw = 0

            for j = 0 to 499
                diff = i - j
                weight = get_weight(diff, bandwidth, kernel_name)
                sumw += weight
                w.weights.push(weight)

            w.sumw := sumw
            c.push(w)
        c
    else
        c

precalculate_nrp(bandwidth, kernel_name)=>
    var float[] weights = array.new<float>()
    var float sumw = 0
    if barstate.isfirst
        for i = 0 to bandwidth - 1
            j = math.pow(i, 2) / (math.pow(bandwidth, 2))
            weight = get_weight(j, 1, kernel_name)
            weights.push(weight)
            sumw += weight
        [weights, sumw]
    else
        [weights, sumw]

// Lógica Visual Repaint (Solo si se activa visualmente)
draw_repaint_visuals(bandwidth, kernel_type, deviations, enable_band, show_labels, line_style, bullish_color, bearish_color, text_color, size, source_val) =>
    var estimate_array = array.new<line>(500, line.new(na, na, na, na)) 
    var dev_upper_array = array.new<line>(500, line.new(na, na, na, na))
    var dev_lower_array = array.new<line>(500, line.new(na, na, na, na))
    var up_labels = array.new<label>(500, label.new(na, na))
    var down_labels = array.new<label>(500, label.new(na, na))      

    float current_price = na
    float previous_price = na
    float previous_price_delta = na
    
    coefficients[] c = precalculate(bandwidth, kernel_type)
    
    if barstate.isfirst
        for i = 499 to 0
            array.set(estimate_array, i, line.new(na, na, na, na))
            if enable_band
                array.set(dev_upper_array, i, line.new(na, na, na, na))
                array.set(dev_lower_array, i, line.new(na, na, na, na))
            if show_labels
                array.set(up_labels, i, label.new(na, na))
                array.set(down_labels,i,  label.new(na, na))    

    if barstate.islast
        for i = 0 to math.min(bar_index, 499)
            coefficient = c.get(i)
            float sum = 0
            float sumsq = 0

            for j = 0 to math.min(bar_index, 499)
                diff = i - j
                weight = coefficient.weights.get(j)
                sum += source_val[j] * weight
                sumsq += sq(source_val[j]) * weight

            current_price := sum / coefficient.sumw
            delta = current_price - previous_price
            
            // Dibujo
            line estimate = array.get(estimate_array, i)
            line.set_xy1(estimate, bar_index - i + 1, previous_price)
            line.set_xy2(estimate, bar_index - i, current_price)
            line.set_style(estimate, line_style)
            line.set_color(estimate, current_price > previous_price ? bearish_color : bullish_color)
            line.set_width(estimate, 3)
            
            previous_price := current_price

// ==========================================
// ─── CÁLCULO PRINCIPAL (NRP) ───
// ==========================================

// Siempre calculamos el NRP para obtener señales de trading válidas
[weights, sumw] = precalculate_nrp(bandwidth, kernel_type)
float nrp_sum = 0.0
float sumsq = 0.0
for i = 0 to bandwidth - 1
    weight = weights.get(i)
    nrp_sum += nz(source[i]) * weight
nrp_sum := nrp_sum / sumw

// Desviaciones para bandas (opcional para lógica, usado para plot)
for i = 0 to bandwidth - 1
    sumsq += math.pow(source[i] - nrp_sum[i], 2)
float nrp_stdev = math.sqrt(sumsq / (bandwidth - 1)) * deviations

// Determinar color y dirección (Lógica de Trading)
bool trend_up = nrp_sum > nrp_sum[1]
color nrp_color = trend_up ? bullish_color : bearish_color

// ==========================================
// ─── LÓGICA DE ESTRATEGIA ───
// ==========================================

// Entrada Long: Cuando la línea cambia a subida (Verde)
if trend_up and not trend_up[1] and in_date_range and use_longs
    strategy.entry("Long", strategy.long, comment="Kernel Bull")

// Entrada Short: Cuando la línea cambia a bajada (Roja)
if not trend_up and trend_up[1] and in_date_range and use_shorts
    strategy.entry("Short", strategy.short, comment="Kernel Bear")

// ==========================================
// ─── VISUALIZACIÓN ───
// ==========================================

// Si el usuario quiere ver el efecto "Repaint", llamamos a la función visual costosa
if repaint_visual
    draw_repaint_visuals(bandwidth, kernel_type, deviations, enable_band, show_labels, line_style, bullish_color, bearish_color, text_color, size, source)

// Plot principal (La línea que sigue la estrategia)
// Si repaint_visual es false, mostramos esta línea claramente. 
// Si es true, la mostramos más tenue para no confundir con la repintada.
plot(nrp_sum, "NRP Signal Line", nrp_color, linewidth = 2, display = repaint_visual ? display.none : display.all)

// Bandas NRP
plot(enable_band ? nrp_sum + nrp_stdev : na, "Upper Deviation", nrp_color, display = repaint_visual ? display.none : display.all)
plot(enable_band ? nrp_sum - nrp_stdev : na, "Lower Deviation", nrp_color, display = repaint_visual ? display.none : display.all)

// Etiquetas de señal en modo NRP
if show_labels and not repaint_visual
    if trend_up and not trend_up[1]
        label.new(bar_index, nrp_sum, "Up", xloc.bar_index, yloc.belowbar, bullish_color, label.style_label_up, text_color, size)
    if not trend_up and trend_up[1]
        label.new(bar_index, nrp_sum, "Down", xloc.bar_index, yloc.abovebar, bearish_color, label.style_label_down, text_color, size)